{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01K48howS51qgKrohzdEmkaT", "type": "tool_result", "content": "1\t\"\"\"Hashed context mixing in the PAQ tradition, trained by gradient descent, with a smaller softmax and a cold-start fix.\n2\t\n3\tExtends the record entry (Mahoney's PAQ/lpaq, fastText hashing, AdaGrad tables, in-window PPM backoff after Cleary &\n4\tWitten and Teh). What changed, each measured on dev:\n5\t\n6\tCold start. A window starts mid-story, but zero padding made its first bytes hash like the start of a story. Contexts\n7\tthat reach back before the window are now masked out at eval, and every COLD_EVERY-th training step sees the same masks.\n8\t\n9\tIn-window votes. They compare raw hashes, since a table's modulus adds false matches, and run five stages.\n10\t\n11\tTraining. Rare bytes share softmax classes (76 against 130), which cuts the price of the head and the cross entropy.\n12\tBatch 128 with table updates half as often halves the per-step dense table work. The mixer learning rate is higher, and\n13\tthe table rate decays over the run. Together these buy more training bytes and a better settled model.\n14\t\n15\tTried and dropped at this budget: word contexts, a tenth order, wider low-order rows, thinner high-order rows, a deeper\n16\tmixer, recency-weighted votes, a logit temperature.\n17\t\"\"\"\n18\t\n19\timport math\n20\t\n21\timport odometer as od\n22\t\n23\tORDERS = (1, 2, 3, 4, 5, 6, 8, 10, 12)\n24\tROWS = (256, 8191, 16381, 32749, 75989, 75989, 104003, 104003, 104003)\n25\tEMBED = 8\n26\tEVERY = (1, 1, 1, 4, 8, 8, 16, 16, 16)\n27\tHIDDEN = 64\n28\tBATCH = 128\n29\tWINDOW = 64\n30\tLR_TABLE = 0.3\n31\tLR_TAIL = 0.4  # the table rate falls linearly to this fraction of LR_TABLE over the run\n32\tLR_MIX = 1.2e-2\n33\tPAD = 32\n34\tLOCAL = ((2, 500.0, 0.35), (3, 24.5, 0.6), (4, 8.4, 0.7), (6, 1.4, 0.6), (16, 0.7, 0.5))  # (order, concentration, discount)\n35\tWARMUP = 0.02\n36\tHASH_A = 16777619\n37\tHASH_B = 2654435761 % (1 << 31)\n38\tCLASSES = 76\n39\tFLOOR = 1e-7\n40\tCOLD_EVERY = 16\n41\t\n42\t\n43\tdef candidates():\n44\t    \"\"\"The bytes the softmax can name. Every other byte gets FLOOR at eval, and shares a class at train.\"\"\"\n45\t    return (0, 10, 32, 33, 34, 39, 44, 45, 46, 51, 52, 53, 54, 56, 57, 58, 59, 63, *range(65, 91), *range(97, 123), 128, 153, 156, 157, 226)\n46\t\n47\t\n48\tdef class_of(b):\n49\t    \"\"\"Softmax class of a candidate byte.\"\"\"\n50\t    if b < 32:\n51\t        return b // 10\n52\t    if b < 65:\n53\t        return 2 + (b - 32) % 16\n54\t    if b < 97:\n55\t        return b - 47\n56\t    return b - 53 if b < 128 else 70 + (b - 128) % 6\n57\t\n58\t\n59\tdef fold(y):\n60\t    \"\"\"The same map on a tensor. Rare bytes share a class with a common one and train it, which costs almost nothing.\"\"\"\n61\t    hi = y // 128\n62\t    ge32 = (y // 32 + 3) // 4\n63\t    ge65 = (y // 65 + 3) // 4\n64\t    ge97 = (y // 97 + 1) // 2\n65\t    low = (1 - ge32) * (y // 10) + (ge32 - ge65) * ((y - 32) % 16 + 2) + (ge65 - ge97) * (y - 47) + ge97 * (y - 53)\n66\t    return low * (1 - hi) + ((y - 128) % 6 + 70) * hi\n67\t\n68\t\n69\tdef init_params():\n70\t    p = {f\"t{k}\": od.zeros((r, EMBED)) for k, r in enumerate(ROWS)}\n71\t    n = EMBED * len(ROWS)\n72\t    p[\"up\"] = od.randn((n, HIDDEN), 1.0 / math.sqrt(n))\n73\t    p[\"bias\"] = od.ones((1, 1, HIDDEN))\n74\t    p[\"head\"] = od.zeros((HIDDEN, CLASSES))\n75\t    return {k: od.param(v) for k, v in p.items()}\n76\t\n77\t\n78\tdef order_rows(z):\n79\t    \"\"\"z holds PAD bytes of history, then the positions to predict. One tensor of table rows per context, (B, T).\"\"\"\n80\t    T = z.shape[1]\n81\t    h = z[:, PAD:] * 0\n82\t    out = []\n83\t    for n in range(1, max(ORDERS) + 1):\n84\t        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n85\t        for i, order in enumerate(ORDERS):\n86\t            if order == n:\n87\t                out.append(h if n == 1 else (h * HASH_B + i) % ROWS[i])\n88\t    return out\n89\t\n90\t\n91\tdef history_masks(T):\n92\t    \"\"\"Per context, 0 at positions whose context reaches back before the start of the window, else 1. (1, T, 1).\"\"\"\n93\t    return [od.concat([od.zeros((1, n - 1, 1)), od.ones((1, T - n + 1, 1))], 1) for n in ORDERS]\n94\t\n95\t\n96\tdef mix(p, rows, masks=None):\n97\t    parts = [od.embedding(p[f\"t{k}\"], r) for k, r in enumerate(rows)]\n98\t    if masks:\n99\t        parts = [e * m for e, m in zip(parts, masks)]\n100\t    a = od.relu(od.concat(parts, -1) @ p[\"up\"] + p[\"bias\"])\n101\t    return (a * a) @ p[\"head\"]\n102\t\n103\t\n104\tdef raw_hashes(z):\n105\t    \"\"\"Unreduced hash per in-window order, since a table's modulus would add false matches. (B, T).\"\"\"\n106\t    T = z.shape[1]\n107\t    h = z[:, PAD:] * 0\n108\t    out = {}\n109\t    for n in range(1, max(i for i, b, d in LOCAL) + 1):\n110\t        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n111\t        out[n] = h\n112\t    return out\n113\t\n114\t\n115\tdef window_votes(rows, x):\n116\t    \"\"\"For each position and byte, how often this window already saw that byte follow this context. Causal: s < t.\"\"\"\n117\t    B, T = x.shape\n118\t    d = rows.reshape(B, T, 1) - rows.reshape(B, 1, T)\n119\t    same = od.tril((d >= 0) * (d <= 0), -1)\n120\t    eye = od.tril(od.ones((256, 256))) - od.tril(od.ones((256, 256)), -1)\n121\t    follows = od.embedding(eye, x[:, 1:])\n122\t    return same[:, :, : T - 1] @ follows\n123\t\n124\t\n125\tdef forward(params, x):\n126\t    z = od.concat([x[:, :PAD] * 0, x], 1)\n127\t    out = od.softmax(mix(params, order_rows(z), history_masks(x.shape[1])), -1)\n128\t    eye = od.tril(od.ones((256, 256))) - od.tril(od.ones((256, 256)), -1)\n129\t    place = od.zeros((CLASSES, 256))\n130\t    for b in candidates():\n131\t        c = class_of(b)\n132\t        place = od.concat([place[:c], place[c : c + 1] + eye[b : b + 1], place[c + 1 :]], 0)\n133\t    p = out @ place + FLOOR\n134\t    raw = raw_hashes(z)\n135\t    for n, beta, disc in LOCAL:\n136\t        c = window_votes(raw[n], x)\n137\t        total = od.sum(c, -1, keepdims=True)\n138\t        kinds = od.sum(c > 0.0, -1, keepdims=True)\n139\t        p = (od.relu(c - disc) + (kinds * disc + beta) * p) / (total + beta)\n140\t    return od.log(p + 1e-12)\n141\t\n142\t\n143\tdef train(data):\n144\t    p = init_params()\n145\t    tables = {f\"t{k}\": e for k, e in enumerate(EVERY)}\n146\t    m = {k: od.zeros(v.shape) for k, v in p.items() if k not in tables}\n147\t    s = {k: od.full(v.shape, 1e-8) for k, v in p.items()}\n148\t    cold = history_masks(WINDOW)\n149\t    start, span = od.used(), od.remaining()\n150\t    worst, step = 0, 0\n151\t    while od.remaining() > 2 * worst + 1_000_000:\n152\t        before = od.used()\n153\t        frac = (before - start) / span\n154\t        sched = frac / WARMUP if frac < WARMUP else 0.5 * (1 + math.cos(math.pi * (frac - WARMUP) / (1 - WARMUP)))\n155\t        z, y = data.batch(BATCH, WINDOW + PAD)\n156\t        step += 1\n157\t        masks = cold if step % COLD_EVERY == 0 else None\n158\t        od.cross_entropy(mix(p, order_rows(z), masks), fold(y[:, PAD:])).backward()\n159\t        c1, c2 = LR_MIX * sched / (1 - 0.9**step), 1 / (1 - 0.99**step)\n160\t        lrt = LR_TABLE * min(1.0, frac / WARMUP) * (1 - (1 - LR_TAIL) * frac)\n161\t        for k, v in p.items():\n162\t            g = v.grad\n163\t            if k in tables:\n164\t                if step % tables[k]:\n165\t                    continue\n166\t                s[k] = s[k] + g * g\n167\t                v.update(v - g * od.rsqrt(s[k]) * lrt)\n168\t            else:\n169\t                m[k] = m[k] * 0.9 + g * 0.1\n170\t                s[k] = s[k] * 0.99 + g * g * 0.01\n171\t                v.update(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n172\t            v.grad = None\n173\t        worst = max(worst, od.used() - before)\n174\t    return p\n175\t"}]}, "parent_tool_use_id": null, "sessi