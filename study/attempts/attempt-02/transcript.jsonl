n        before = od.used()\n        frac = (before - start) / span\n        sched = frac / WARMUP if frac < WARMUP else 0.5 * (1 + math.cos(math.pi * (frac - WARMUP) / (1 - WARMUP)))\n        z, y = data.batch(BATCH, WINDOW + PAD)\n        step += 1\n        masks = cold if step % COLD_EVERY == 0 else None\n        od.cross_entropy(mix(p, order_rows(z), masks), fold(y[:, PAD:])).backward()\n        c1, c2 = LR_MIX * sched / (1 - 0.9**step), 1 / (1 - 0.99**step)\n        lrt = LR_TABLE * min(1.0, frac / WARMUP) * (1 - (1 - LR_TAIL) * frac)\n        for k, v in p.items():\n            g = v.grad\n            if k in tables:\n                if step % tables[k]:\n                    continue\n                s[k] = s[k] + g * g\n                v.update(v - g * od.rsqrt(s[k]) * lrt)\n            else:\n                m[k] = m[k] * 0.9 + g * 0.1\n                s[k] = s[k] * 0.99 + g * g * 0.01\n                v.update(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n            v.grad = None\n        worst = max(worst, od.used() - before)\n    return p\n\n\ndef train(data):\n    p = fit_tables(data, od.remaining() * GATE_SHARE)\n    return p | fit_gate(p, data)\n'''\nnew = new.replace('COLD_EVERY = 16\\n', 'COLD_EVERY = 16\\nGATE = 16\\nGATE_BATCH = 2\\nGATE_LR = 0.01\\nGATE_SHARE = 0.08\\nEVAL_T = 512\\n')\nopen('lab/e1/train.py','w').write(new)\nEOF\ncat > lab/proto.py <<'EOF'\n\"\"\"proto.py entry params_dir gate_budget [nwin]: fit only the gate on saved tables, then score on a dev subset.\"\"\"\nimport importlib.util, json, sys, time, pathlib\nimport numpy as np\nROOT = pathlib.Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(ROOT))\nimport odometer as od\nfrom odometer import _data, _engine\nentry, pdir, gb = sys.argv[1], pathlib.Path(sys.argv[2]), float(sys.argv[3])\nnwin = int(sys.argv[4]) if len(sys.argv) > 4 else 256\nspec = importlib.util.spec_from_file_location(\"entry\", entry); M = importlib.util.module_from_spec(spec); spec.loader.exec_module(M)\nnames = json.loads((pdir / \"names.json\").read_text()); st = np.load(pdir / \"params.npz\")\nbase = {n: st[f\"p{i}\"] for i, n in enumerate(names) if not n.startswith(\"g\")}\n_engine._M.reset(int(gb), 7)\ndata = _data.TrainData()\np = {k: od.param(od.Tensor(v.copy())) for k, v in base.items()}\nt0 = time.time()\nq = M.fit_gate(p, data)\nprint(\"fit s\", time.time() - t0, \"ticks\", _engine._M.used)\nall_p = {k: od.Tensor(v._d) for k, v in {**p, **q}.items()}\nw = _data.heldout_windows(\"dev\", 512, 1024)\nw = w[np.random.default_rng(5).permutation(len(w))[:nwin]]\n_engine._M.reset(None, 8, mode=\"eval\")\ntot = 0.0; t0 = time.time()\nfor s in range(0, len(w), 16):\n    b = w[s:s+16]\n    u0 = _engine._M.used\n    z = M.forward(all_p, od.Tensor(b[:, :512].astype(np.int32)))._d.astype(np.float64)\n    tpb = (_engine._M.used - u0) / b[:, :512].size\n    lp = z - z.max(-1, keepdims=True); lp -= np.log(np.exp(lp).sum(-1, keepdims=True))\n    tot += -np.take_along_axis(lp, b[:, 1:, None].astype(int), 2).sum()\nprint(\"bpb subset\", tot / (len(w) * 512) / np.log(2), \"eval tpb\", tpb, \"eval s\", time.time() - t0)\nfor k in q:\n    a = q[k]._d; print(k, a.shape, \"abs mean %.3f max %.3f\" % (np.abs(a).mean(), np.abs(a).max()))\nEOF\ncat lab/*.out; date; python verify.py lab/e1/train.py --smoke --seeds 11, --out lab/smoke.json 2>&1 | tail -5; cat lab/*.out", "description": "Write two-phase entry prototype and smoke test it", "timeout": 400000}}}
