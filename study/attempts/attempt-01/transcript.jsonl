   p[\"up\"] = od.randn((n, HIDDEN), 1.0 / math.sqrt(n))\n45\t    p[\"bias\"] = od.ones((1, 1, HIDDEN))\n46\t    p[\"head\"] = od.zeros((HIDDEN, CLASSES))\n47\t    return {k: od.param(v) for k, v in p.items()}\n48\t\n49\t\n50\tdef is_letter(b):\n51\t    \"\"\"1 for bytes from 65 up, which is letters and UTF-8 in this corpus, 0 for the rest.\"\"\"\n52\t    return (b // 65 + 3) // 4\n53\t\n54\t\n55\tdef word_rows(z):\n56\t    \"\"\"Hashes of the current word's prefix and of the words before it, scanning each row once.\"\"\"\n57\t    B, T = z.shape\n58\t    w = z[:, :1] * 0\n59\t    prev1, prev2 = w, w\n60\t    cols = [[] for r in WORD_ROWS]\n61\t    for t in range(T):\n62\t        b = z[:, t : t + 1]\n63\t        keep = is_letter(b)\n64\t        ended = 1 - keep\n65\t        moved = ended * ((w % 1073741824 + 1073741823) // 1073741824)\n66\t        prev2 = prev2 * (1 - moved) + prev1 * moved\n67\t        prev1 = prev1 * (1 - moved) + w * moved\n68\t        w = (w * HASH_A + b + 1) * keep\n69\t        if t >= PAD:\n70\t            c = [w, w * 31 + prev1 * HASH_B, w * 37 + prev1 * HASH_B + prev2 * 40503]\n71\t            for i in range(len(WORD_ROWS)):\n72\t                cols[i].append(c[i])\n73\t    k = len(ROWS)\n74\t    return [(od.concat(col, 1) * HASH_B + k + i) % WORD_ROWS[i] for i, col in enumerate(cols)]\n75\t\n76\t\n77\tdef order_rows(z):\n78\t    \"\"\"z holds PAD bytes of history, then the positions to predict. One tensor of table rows per context, (B, T).\"\"\"\n79\t    T = z.shape[1]\n80\t    h = z[:, PAD:] * 0\n81\t    out = []\n82\t    for n in range(1, max(ORDERS) + 1):\n83\t        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n84\t        for i, order in enumerate(ORDERS):\n85\t            if order == n:\n86\t                out.append(h if n == 1 else (h * HASH_B + i) % ROWS[i])\n87\t    return out + (word_rows(z) if WORD_ROWS else [])\n88\t\n89\t\n90\tdef mix(p, rows):\n91\t    parts = [od.embedding(p[f\"t{k}\"], r) for k, r in enumerate(rows)]\n9