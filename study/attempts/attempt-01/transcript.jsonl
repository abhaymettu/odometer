6\t\n57\tdef ci95(xs):\n58\t    m, sd = mean_sd(xs)\n59\t    half = t_ppf(0.975, len(xs) - 1) * sd / math.sqrt(len(xs))\n60\t    return m, half\n61\t\n62\t\n63\tdef welch(a, b):\n64\t    \"\"\"Is mean(a) below mean(b)? Returns the difference, its 95% CI half-width, and the one-sided p.\"\"\"\n65\t    ma, sa = mean_sd(a)\n66\t    mb, sb = mean_sd(b)\n67\t    va, vb = sa * sa / len(a), sb * sb / len(b)\n68\t    se = math.sqrt(va + vb)\n69\t    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n70\t    diff = ma - mb\n71\t    return {\"diff\": diff, \"ci95\": t_ppf(0.975, df) * se, \"p_one_sided\": t_cdf(diff / se, df), \"df\": df}\n72\t\n73\t\n74\tdef tost(a, b, margin):\n75\t    \"\"\"Two one-sided tests: are the means of a and b within +-margin of each other? Returns the larger p.\"\"\"\n76\t    ma, sa = mean_sd(a)\n77\t    mb, sb = mean_sd(b)\n78\t    va, vb = sa * sa / len(a), sb * sb / len(b)\n79\t    se = math.sqrt(va + vb)\n80\t    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n81\t    d = ma - mb\n82\t    p_low = 1 - t_cdf((d + margin) / se, df)\n83\t    p_high = t_cdf((d - margin) / se, df)\n84\t    return {\"diff\": d, \"p\": max(p_low, p_high), \"ci90\": t_ppf(0.95, df) * se}\n85\t\n86\t\n87\tdef wilson(k, n, z=1.959964):\n88\t    if n == 0:\n89\t        return float(\"nan\"), float(\"nan\")\n90\t    p = k / n\n91\t    centre = (p + z * z / (2 * n)) / (1 + z * z / n)\n92\t    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)\n93\t    return centre - half, centre + half\n94\t"}]}, "parent_tool_use_id": null, "session_id": "c1587825-b49a-4867-a7de-efec5b369583", "uuid": "9107048c-ce70-4f59-be63-3be4dfcbdc63", "timestamp": "2026-11-02T13:40:24.647Z", "tool_use_result": {"type": "text", "file": {"filePath": "/home/user/att/attempt-01/stats.py", "content": "\"\"\"The few statistics the track needs, with no dependency beyond the standard library.\"\"\"\n\nimport math\n\n\ndef mean_sd(xs):