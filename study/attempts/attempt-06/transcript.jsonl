{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_017KcMGeXm7uK5FkTgjLKN1u", "type": "tool_result", "content": "1\t\"\"\"Hashed context mixing by gradient descent, then a learned in-window PPM stage, with a gate fitted on fresh data.\n2\t\n3\tThe table model and the in-window stages are the previous record's. The change is in how the gate is fitted, because\n4\tmeasurement showed it is short of fresh bytes and not of gradient steps: on cached tables, four times the gate budget\n5\tgains about 0.005 bpb, and more passes per batch make it worse.\n6\t\n7\t1. One gradient step per gate batch instead of three, so the same ticks see more windows.\n8\t2. The gate's MLP is gone. It added nothing measurable, and its ticks go to more data.\n9\t3. The gate table on the previous byte is the part that pays (removing it costs 0.0055 bpb). A second table on a hash of\n10\t   the last two bytes joins it, and both train by AdaGrad, as rows hit sparsely do badly under Adam.\n11\t\n12\tThe tables give up 3 * 2004 rows to stay under the parameter cap.\n13\t\n14\tMeasured and dropped: re-centred constants for the stages, more gate budget taken from the tables, cheaper tables by\n15\tthinner rows, fewer orders or sampled backward, shorter table windows, parameter averaging, an output mix over every\n16\tstage of the back-off.\n17\t\"\"\"\n18\t\n19\timport math\n20\t\n21\timport odometer as od\n22\t\n23\tORDERS = (1, 2, 3, 4, 5, 6, 8, 10, 12)\n24\tROWS = (256, 8191, 16381, 32749, 75989, 75989, 101999, 101999, 101999)\n25\tEMBED = 8\n26\tEVERY = (1, 1, 1, 4, 8, 8, 16, 16, 16)\n27\tHIDDEN = 64\n28\tBATCH = 128\n29\tWINDOW = 64\n30\tLR_TABLE = 0.3\n31\tLR_TAIL = 0.4  # the table rate falls linearly to this fraction of LR_TABLE over the run\n32\tLR_MIX = 1.2e-2\n33\tPAD = 32\n34\tWORD_K = 16\n35\tLOCAL = ((1, 100.0, 0.02), (2, 22.7, 0.022), (3, 7.0, 0.343), (101, 6.0, 0.3), (4, 5.5, 0.226), (102, 3.0, 0.4), (6, 0.85, 0.684), (16, 0.39, 0.6))  # (order, concentration, discount) before the gates\n36\tMIXW = (0.51, 0.55)  # logit weight of the softmax and of each stage before the gates  # (order, concentration, discount)\n37\tWARMUP = 0.02\n38\tHASH_A = 16777619\n39\tHASH_B = 2654435761 % (1 << 31)\n40\tCLASSES = 76\n41\tFLOOR = 1e-7\n42\tCOLD_EVERY = 16\n43\tSAMPLE = (4, 4, 4, 2, 1, 1, 1, 1, 1)\n44\tFULL = 0.15\n45\tGATE_BATCH = 4\n46\tGATE_T = 256\n47\tGATE_LR = 0.02\n48\tGATE_SHARE = 0.08\n49\tGATE_TAB = 0.1\n50\tGATE_TABLES = (\"g4\", \"g5\")\n51\tEVAL_T = 512\n52\t\n53\t\n54\tdef candidates():\n55\t    \"\"\"The bytes the softmax can name. Every other byte gets FLOOR at eval, and shares a class at train.\"\"\"\n56\t    return (0, 10, 32, 33, 34, 39, 44, 45, 46, 51, 52, 53, 54, 56, 57, 58, 59, 63, *range(65, 91), *range(97, 123), 128, 153, 156, 157, 226)\n57\t\n58\t\n59\tdef class_of(b):\n60\t    \"\"\"Softmax class of a candidate byte.\"\"\"\n61\t    if b < 32:\n62\t        return b // 10\n63\t    if b < 65:\n64\t        return 2 + (b - 32) % 16\n65\t    if b < 97:\n66\t        return b - 47\n67\t    return b - 53 if b < 128 else 70 + (b - 128) % 6\n68\t\n69\t\n70\tdef fold(y):\n71\t    \"\"\"The same map on a tensor. Rare bytes share a class with a common one and train it, which costs almost nothing.\"\"\"\n72\t    hi = y // 128\n73\t    ge32 = (y // 32 + 3) // 4\n74\t    ge65 = (y // 65 + 3) // 4\n75\t    ge97 = (y // 97 + 1) // 2\n76\t    low = (1 - ge32) * (y // 10) + (ge32 - ge65) * ((y - 32) % 16 + 2) + (ge65 - ge97) * (y - 47) + ge97 * (y - 53)\n77\t    return low * (1 - hi) + ((y - 128) % 6 + 70) * hi\n78\t\n79\t\n80\tdef init_params():\n81\t    p = {f\"t{k}\": od.zeros((r, EMBED)) for k, r in enumerate(ROWS)}\n82\t    n = EMBED * len(ROWS)\n83\t    p[\"up\"] = od.randn((n, HIDDEN), 1.0 / math.sqrt(n))\n84\t    p[\"bias\"] = od.ones((1, 1, HIDDEN))\n85\t    p[\"head\"] = od.zeros((HIDDEN, CLASSES))\n86\t    return {k: od.param(v) for k, v in p.items()}\n87\t\n88\t\n89\tdef order_rows(z):\n90\t    \"\"\"z holds PAD bytes of history, then the positions to predict. One tensor of table rows per context, (B, T).\"\"\"\n91\t    T = z.shape[1]\n92\t    h = z[:, PAD:] * 0\n93\t    out = []\n94\t    for n in range(1, max(ORDERS) + 1):\n95\t        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n96\t        for i, order in enumerate(ORDERS):\n97\t            if order == n:\n98\t                out.append(h if n == 1 else (h * HASH_B + i) % ROWS[i])\n99\t    return out\n100\t\n101\t\n102\tdef history_masks(T):\n103\t    \"\"\"Per context, 0 at positions whose context reaches back before the start of the window, else 1. (1, T, 1).\"\"\"\n104\t    return [od.concat([od.zeros((1, n - 1, 1)), od.ones((1, T - n + 1, 1))], 1) for n in ORDERS]\n105\t\n106\t\n107\tdef mix(p, rows, masks=None, live=None):\n108\t    parts = [od.embedding(p[f\"t{k}\"] if live is None or live[k] else p[f\"t{k}\"].detach(), r) for k, r in enumerate(rows)]\n109\t    if masks:\n110\t        parts = [e * m for e, m in zip(parts, masks)]\n111\t    a = od.relu(od.concat(parts, -1) @ p[\"up\"] + p[\"bias\"])\n112\t    return (a * a) @ p[\"head\"]\n113\t\n114\t\n115\tdef word_hashes(z):\n116\t    \"\"\"Causal word contexts. Hashes of: current word prefix; plus previous word; plus the one before.\"\"\"\n117\t    T = z.shape[1]\n118\t    ge65 = (z // 65 + 3) // 4\n119\t    low = z + (ge65 - (z // 97 + 1) // 2) * 32\n120\t    h = z[:, PAD:] * 0\n121\t    p1, p2 = h, h\n122\t    for n in range(WORD_K, 0, -1):\n123\t        a, b = PAD - n + 1, T - n + 1\n124\t        L = ge65[:, a:b]\n125\t        e = ge65[:, a - 1 : b - 1] * (1 - L)\n126\t        k = 1 - e\n127\t        p2 = p2 * k + p1 * e\n128\t        p1 = p1 * k + h * e\n129\t        h = (h * HASH_A + low[:, a:b]) * L\n130\t    w0 = h * HASH_B + z[:, PAD:]\n131\t    w1 = w0 * HASH_A + p1\n132\t    return w0, w1, w1 * HASH_A + p2\n133\t\n134\tdef raw_hashes(z):\n135\t    \"\"\"Unreduced hash per in-window order, since a table's modulus would add false matches. (B, T).\"\"\"\n136\t    T = z.shape[1]\n137\t    h = z[:, PAD:] * 0\n138\t    out = {}\n139\t    for n in range(1, max(i for i, b, d in LOCAL if i < 100) + 1):\n140\t        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n141\t        out[n] = h\n142\t    w = word_hashes(z)\n143\t    return out | {101: w[0], 102: w[1], 103: w[2]}\n144\t\n145\t\n146\tdef identity(n):\n147\t    return od.tril(od.ones((n, n))) - od.tril(od.ones((n, n)), -1)\n148\t\n149\t\n150\tdef local_stats(z, x):\n151\t    \"\"\"Per in-window order: votes per class, their total, and how many classes have a vote.\"\"\"\n152\t    B, T = x.shape\n153\t    raw = raw_hashes(z)\n154\t    mask = od.tril(od.ones((1, T, T)), -1)\n155\t    ends = od.sum(od.embedding(identity(256)[:, :1], x), -1, keepdims=True)\n156\t    run = od.tril(od.ones((1, T, T))) @ ends\n157\t    cross = (run - run.reshape(B, 1, T)) > 0.5\n158\t    mask = mask * (1.0 - cross * 0.9)\n159\t    follows = od.embedding(identity(CLASSES), fold(x[:, 1:]))\n160\t    out = []\n161\t    for n, beta, disc in LOCAL:\n162\t        d = raw[n].reshape(B, T, 1) - raw[n].reshape(B, 1, T)\n163\t        same = (d >= 0) * (d <= 0) * mask\n164\t        c = same[:, :, : T - 1] @ follows\n165\t        out.append((c, od.sum(c, -1, keepdims=True), od.sum(c > 0.0, -1, keepdims=True)))\n166\t    return out\n167\t\n168\t\n169\tdef base_probs(p, z, x):\n170\t    return od.softmax(mix(p, order_rows(z), history_masks(x.shape[1])), -1)\n171\t\n172\t\n173\tdef features(p0, stats):\n174\t    ent = od.sum(p0 * od.log(p0 + 1e-9), -1, keepdims=True) * -0.25\n175\t    top = od.max(p0, -1, keepdims=True)\n176\t    parts = [ent, top, od.ones((1, 1, 1)) + p0[:, :, :1] * 0.0]\n177\t    for c, t, k in stats:\n178\t        seen = t > 0.0\n179\t        parts += [od.log(t + 1.0) * 0.25, od.log(k + 1.0) * 0.5, seen, seen * (k <= 1.0), od.max(c, -1, keepdims=True) / (t + 1.0)]\n180\t    return od.concat(parts, -1)\n181\t\n182\t\n183\tdef gate_params():\n184\t    n = len(LOCAL)\n185\t    nf = 3 + 5 * n\n186\t    nout = 2 * n + 2\n187\t    q = {\"g3\": od.zeros((nf, nout)), \"g4\": od.zeros((256, nout)), \"g5\": od.zeros((2039, nout))}\n188\t    return {k: od.param(v) for k, v in q.items()}\n189\t\n190\t\n191\tdef gates(q, f, x):\n192\t    return f @ q[\"g3\"] + od.embedding(q[\"g4\"], x) + od.embedding(q[\"g5\"], (x * 251 + od.concat([x[:, :1] * 0, x[:, :-1]], 1)) % 2039)\n193\t\n194\t\n195\tdef blend(q, p0, stats, x):\n196\t    \"\"\"Back off through the in-window orders with learned concentrations and discounts, then mix all stages as logits.\"\"\"\n197\t    n = len(LOCAL)\n198\t    f = features(p0, stats)\n199\t    out = gates(q, f, x)\n200\t    p = p0\n201\t    for i, (order, beta, disc) in enumerate(LOCAL):\n202\t        c, t, k = stats[i]\n203\t        b = od.exp(out[:, :, i : i + 1]) * beta\n204\t        d = od.sigmoid(out[:, :, n + i : n + i + 1] + math.log(disc / (1 - disc)))\n205\t        p = (od.relu(c - d) + (k * d + b) * p) / (t + b)\n206\t    a0 = out[:, :, 2 * n : 2 * n + 1] + MIXW[0]\n207\t    a1 = out[:, :, 2 * n + 1 : 2 * n + 2] + MIXW[1]\n208\t    return od.log(p0 + 1e-9) * a0 + od.log(p + 1e-9) * a1\n209\t\n210\t\n211\tdef forward(params, x):\n212\t    z = od.concat([x[:, :PAD] * 0, x], 1)\n213\t    p0 = base_probs(params, z, x)\n214\t    out = od.softmax(blend(params, p0, local_stats(z, x), x), -1)\n215\t    eye = identity(256)\n216\t    place = od.zeros((CLASSES, 256))\n217\t    for b in candidates():\n218\t        c = class_of(b)\n219\t        place = od.concat([place[:c], place[c : c + 1] + eye[b : b + 1], place[c + 1 :]], 0)\n220\t    return od.log(out @ place + FLOOR)\n221\t\n222\t\n223\tdef fit_gate(p, data):\n224\t    q = gate_params()\n225\t    m = {k: od.zeros(v.shape) for k, v in q.items()}\n226\t    s = {k: od.full(v.shape, 1e-8) for k, v in q.items()}\n227\t    start, span = od.used(), od.remaining()\n228\t    worst, step = 0, 0\n229\t    while od.remaining() > 2 * worst + 1_000_000:\n230\t        before = od.used()\n231\t        frac = (before - start) / span\n232\t        z, y = data.batch(GATE_BATCH, GATE_T + PAD)\n233\t        x = z[:, PAD:]\n234\t        with od.no_grad():\n235\t            p0 = base_probs(p, z, x)\n236\t            stats = local_stats(z, x)\n237\t        for again in range(1):\n238\t            od.cross_entropy(blend(q, p0, stats, x), fold(y[:, PAD:])).backward()\n239\t            step += 1\n240\t            c1, c2 = GATE_LR * 0.5 * (1 + math.cos(math.pi * frac)) / (1 - 0.9**step), 1 / (1 - 0.99**step)\n241\t            for k, v in q.items():\n242\t                g = v.grad\n243\t                if k in GATE_TABLES:\n244\t                    s[k] = s[k] + g * g\n245\t                    v.update(v - g * od.rsqrt(s[k]) * (GATE_TAB * (1 - 0.7 * frac)))\n246\t                    v.grad = None\n247\t                    continue\n248\t                m[k] = m[k] * 0.9 + g * 0.1\n249\t                s[k] = s[k] * 0.99 + g * g * 0.01\n250\t                v.update(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n251\t                v.grad = None\n252\t        worst = max(worst, od.used() - before)\n253\t    return q\n254\t\n255\t\n256\tdef fit_tables(data, stop):\n257\t    p = init_params()\n258\t    tables = {f\"t{k}\": e for k, e in enumerate(EVERY)}\n259\t    m = {k: od.zeros(v.shape) for k, v in p.items() if k not in tables}\n260\t    s = {k: od.full(v.shape, 1e-8) for k, v in p.items()}\n261\t    cold = history_masks(WINDOW)\n262\t    start, span = od.used(), od.remaining() - stop\n263\t    worst, step = 0, 0\n264\t    while od.remaining() - stop > 2 * worst + 1_000_000:\n265\t        before = od.used()\n266\t        frac = (before - start) / span\n267\t        sched = frac / WARMUP if frac < WARMUP else 0.5 * (1 + math.cos(math.pi * (frac - WARMUP) / (1 - WARMUP)))\n268\t        z, y = data.batch(BATCH, WINDOW + PAD)\n269\t        step += 1\n270\t        masks = cold if step % COLD_EVERY == 0 else None\n271\t        live = [frac < FULL or step % e == 0 for e in SAMPLE]\n272\t        od.cross_entropy(mix(p, order_rows(z), masks, live), fold(y[:, PAD:])).backward()\n273\t        c1, c2 = LR_MIX * sched / (1 - 0.9**step), 1 / (1 - 0.99**step)\n274\t        lrt = LR_TABLE * min(1.0, frac / WARMUP) * (1 - (1 - LR_TAIL) * frac)\n275\t        for k, v in p.items():\n276\t            g = v.grad\n277\t            if k in tables:\n278\t                if g is None or step % tables[k]:\n279\t                    continue\n280\t                s[k] = s[k] + g * g\n281\t                v.update(v - g * od.rsqrt(s[k]) * lrt)\n282\t            else:\n283\t                m[k] = m[k] * 0.9 + g * 0.1\n284\t                s[k] = s[k] * 0.99 + g * g * 0.01\n285\t                v.update(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n286\t            v.grad = None\n287\t        worst = max(worst, od.used() - before)\n288\t    return p\n289\t\n290\t\n291\tdef train(data):\n292\t    p = fit_tables(data, od.remaining() * GATE_SHARE)\n293\t    return p | fit_gate(p, data)\n294\t"}]}, "parent_tool_use_id": null, "session_id": "507db3bc-24cf-4b4c-ac88-8eb6bce6499d", "uuid": "69489869-a0d5-4ad5-83da-dcf2e7d5dd96", "timestamp": "2026-11-02T20:15:37.767Z", "tool_use_result": {"type": "text", "file": {"filePath": "/home/user/att/attempt-06/entries/current/train.py", "content": "\"\"\"Hashed context mixing by gradient descent, then a learned in-window PPM stage, with a gate fitted on fresh data.\n\nThe table model and the in-window stages are the previous record's. The change is in how the gate is fitted, because\nmeasurement showed it is short of fresh bytes and not of gradient steps: on cached tables, four times the gate budget\ngains about 0.005 bpb, and more passes per batch make it worse.\n\n1. One gradient step per gate batch instead of three, so the same ticks see more windows.\n2. The gate's MLP is gone. It added nothing measurable, and its ticks go to more data.\n3. The gate table on the previous byte is the part that pays (removing it costs 0.0055 bpb). A second table on a hash of\n   the last two bytes joins it, and both train by AdaGrad, as rows hit sparsely do badly under Adam.\n\nThe tables give up 3 * 2004 rows to stay under the parameter cap.\n\nMeasured and dropped: re-centred constants for the stages, more gate budget taken from the tables, cheaper tables by\nthinner rows, fewer orders or sampled backward, shorter table windows, parameter averaging, an output mix over every\nstage of the back-off.\n\"\"\"\n\nimport math\n\nimport odometer as od\n\nORDERS = (1, 2, 3, 4, 5, 6, 8, 10, 12)\nROWS = (256, 8191, 16381, 32749, 75989, 75989, 101999, 101999, 101999)\nEMBED = 8\nEVERY = (1, 1, 1, 4, 8, 8, 16, 16, 16)\nHIDDEN = 64\nBATCH = 128\nWINDOW = 64\nLR_TABLE = 0.3\nLR_TAIL = 0.4  # the table rate falls linearly to this fraction of LR_TABLE over the run\nLR_MIX = 1.2e-2\nPAD = 32\nWORD_K = 16\nLOCAL = ((1, 100.0, 0.02), (2, 22.7, 0.022), (3, 7.0, 0.343), (101, 6.0, 0.3), (4, 5.5, 0.226), (102, 3.0, 0.4), (6, 0.85, 0.684), (16, 0.39, 0.6))  # (order, concentration, discount) before the gates\nMIXW = (0.51, 0.55)  # logit weight of the softmax and of each stage before the gates  # (order, concentration, discount)\nWARMUP = 0.02\nHASH_A = 16777619\nHASH_B = 2654435761 % (1 << 31)\nCLASSES = 76\nFLOOR = 1e-7\nCOLD_EVERY = 16\nSAMPLE = (4, 4, 4, 2, 1, 1, 1, 1, 1)\nFULL = 0.15\nGATE_BATCH = 4\nGATE_T = 256\nGATE_LR = 0.02\nGATE_SHARE = 0.08\nGATE_TAB = 0.1\nGATE_TABLES = (\"g4\", \"g5\")\nEVAL_T = 512\n\n\ndef candidates():\n    \"\"\"The bytes the softmax can name. Every other byte gets FLOOR at eval, and shares a class at train.\"\"\"\n    return (0, 10, 32, 33, 34, 39, 44, 45, 46, 51, 52, 53, 54, 56, 57, 58, 59, 63, *range(65, 91), *range(97, 123), 128, 153, 156, 157, 226)\n\n\ndef class_of(b):\n    \"\"\"Softmax class of a candidate byte.\"\"\"\n    if b < 32:\n        return b // 10\n    if b < 65:\n        return 2 + (b - 32) % 16\n    if b < 97:\n        return b - 47\n    return b - 53 if b < 128 else 70 + (b - 128) % 6\n\n\ndef fold(y):\n    \"\"\"The same map on a tensor. Rare bytes share a class with a common one and train it, which costs almost nothing.\"\"\"\n    hi = y // 128\n    ge32 = (y // 32 + 3) // 4\n    ge65 = (y // 65 + 3) // 4\n    ge97 = (y // 97 + 1) // 2\n    low = (1 - ge32) * (y // 10) + (ge32 - ge65) * ((y - 32) % 16 + 2) + (ge65 - ge97) * (y - 47) + ge97 * (y - 53)\n    return low * (1 - hi) + ((y - 128) % 6 + 70) * hi\n\n\ndef init_params():\n    p = {f\"t{k}\": od.zeros((r, EMBED)) for k, r in enumerate(ROWS)}\n    n = EMBED * len(ROWS)\n    p[\"up\"] = od.randn((n, HIDDEN), 1.0 / math.sqrt(n))\n    p[\"bias\"] = od.ones((1, 1, HIDDEN))\n    p[\"head\"] = od.zeros((HIDDEN, CLASSES))\n    return {k: od.param(v) for k, v in p.items()}\n\n\ndef order_rows(z):\n    \"\"\"z holds PAD bytes of history, then the positions to predict. One tensor of table rows per context, (B, T).\"\"\"\n    T = z.shape[1]\n    h = z[:, PAD:] * 0\n    out = []\n    for n in range(1, max(ORDERS) + 1):\n        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n        for i, order in enumerate(ORDERS):\n            if order == n:\n                out.append(h if n == 1 else (h * HASH_B + i) % ROWS[i])\n    return out\n\n\ndef history_masks(T):\n    \"\"\"Per context, 0 at positions whose context reaches back before the start of the window, else 1. (1, T, 1).\"\"\"\n    return [od.concat([od.zeros((1, n - 1, 1)), od.ones((1, T - n + 1, 1))], 1) for n in ORDERS]\n\n\ndef mix(p, rows, masks=None, live=None):\n    parts = [od.embedding(p[f\"t{k}\"] if live is None or live[k] else p[f\"t{k}\"].detach(), r) for k, r in enumerate(rows)]\n    if masks:\n        parts = [e * m for e, m in zip(parts, masks)]\n    a = od.relu(od.concat(parts, -1) @ p[\"up\"] + p[\"bias\"])\n    return (a * a) @ p[\"head\"]\n\n\ndef word_hashes(z):\n    \"\"\"Causal word contexts. Hashes of: current word prefix; plus previous word; plus the one before.\"\"\"\n    T = z.shape[1]\n    ge65 = (z // 65 + 3) // 4\n    low = z + (ge65 - (z // 97 + 1) // 2) * 32\n    h = z[:, PAD:] * 0\n    p1, p2 = h, h\n    for n in range(WORD_K, 0, -1):\n        a, b = PAD - n + 1, T - n + 1\n        L = ge65[:, a:b]\n        e = ge65[:, a - 1 : b - 1] * (1 - L)\n        k = 1 - e\n        p2 = p2 * k + p1 * e\n        p1 = p1 * k + h * e\n        h = (h * HASH_A + low[:, a:b]) * L\n    w0 = h * HASH_B + z[:, PAD:]\n    w1 = w0 * HASH_A + p1\n    return w0, w1, w1 * HASH_A + p2\n\ndef raw_hashes(z):\n    \"\"\"Unreduced hash per in-window order, since a table's modulus would add false matches. (B, T).\"\"\"\n    T = z.shape[1]\n    h = z[:, PAD:] * 0\n    out = {}\n    for n in range(1, max(i for i, b, d in LOCAL if i < 100) + 1):\n        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n        out[n] = h\n    w = word_hashes(z)\n    return out | {101: w[0], 102: w[1], 103: w[2]}\n\n\ndef identity(n):\n    return od.tril(od.ones((n, n))) - od.tril(od.ones((n, n)), -1)\n\n\ndef local_stats(z, x):\n    \"\"\"Per in-window order: votes per class, their total, and how many classes have a vote.\"\"\"\n    B, T = x.shape\n    raw = raw_hashes(z)\n    mask = od.tril(od.ones((1, T, T)), -1)\n    ends = od.sum(od.embedding(identity(256)[:, :1], x), -1, keepdims=True)\n    run = od.tril(od.ones((1, T, T))) @ ends\n    cross = (run - run.reshape(B, 1, T)) > 0.5\n    mask = mask * (1.0 - cross * 0.9)\n    follows = od.embedding(identity(CLASSES), fold(x[:, 1:]))\n    out = []\n    for n, beta, disc in LOCAL:\n        d = raw[n].reshape(B, T, 1) - raw[n].reshape(B, 1, T)\n        same = (d >= 0) * (d <= 0) * mask\n        c = same[:, :, : T - 1] @ follows\n        out.append((c, od.sum(c, -1, keepdims=True), od.sum(c > 0.0, -1, keepdims=True)))\n    return out\n\n\ndef base_probs(p, z, x):\n    return od.softmax(mix(p, order_rows(z), history_masks(x.shape[1])), -1)\n\n\ndef features(p0, stats):\n    ent = od.sum(p0 * od.log(p0 + 1e-9), -1, keepdims=True) * -0.25\n    top = od.max(p0, -1, keepdims=True)\n    parts = [ent, top, od.ones((1, 1, 1)) + p0[:, :, :1] * 0.0]\n    for c, t, k in stats:\n        seen = t > 0.0\n        parts += [od.log(t + 1.0) * 0.25, od.log(k + 1.0) * 0.5, seen, seen * (k <= 1.0), od.max(c, -1, keepdims=True) / (t + 1.0)]\n    return od.concat(parts, -1)\n\n\ndef gate_params():\n    n = len(LOCAL)\n    nf = 3 + 5 * n\n    nout = 2 * n + 2\n    q = {\"g3\": od.zeros((nf, nout)), \"g4\": od.zeros((256, nout)), \"g5\": od.zeros((2039, nout))}\n    return {k: od.param(v) for k, v in q.items()}\n\n\ndef gates(q, f, x):\n    return f @ q[\"g3\"] + od.embedding(q[\"g4\"], x) + od.embedding(q[\"g5\"], (x * 251 + od.concat([x[:, :1] * 0, x[:, :-1]], 1)) % 2039)\n\n\ndef blend(q, p0, stats, x):\n    \"\"\"Back off through the in-window orders with learned concentrations and discounts, then mix all stages as logits.\"\"\"\n    n = len(LOCAL)\n    f = features(p0, stats)\n    out = gates(q, f, x)\n    p = p0\n    for i, (order, beta, disc) in enumerate(LOCAL):\n        c, t, k = stats[i]\n        b = od.exp(out[:, :, i : i + 1]) * beta\n        d = od.sigmoid(out[:, :, n + i : n + i + 1] + math.log(disc / (1 - disc)))\n        p = (od.relu(c - d) + (k * d + b) * p) / (t + b)\n    a0 = out[:, :, 2 * n : 2 * n + 1] + MIXW[0]\n    a1 = out[:, :, 2 * n + 1 : 2 * n + 2] + MIXW[1]\n    return od.log(p0 + 1e-9) * a0 + od.log(p + 1e-9) * a1\n\n\ndef forward(params, x):\n    z = od.concat([x[:, :PAD] * 0, x], 1)\n    p0 = base_probs(params, z, x)\n    out = od.softmax(blend(params, p0, local_stats(z, x), x), -1)\n    eye = identity(256)\n    place = od.zeros((CLASSES, 256))\n    for b in candidates():\n        c = class_of(b)\n        place = od.concat([place[:c], place[c : c + 1] + eye[b : b + 1], place[c + 1 :]], 0)\n    return od.log(out @ place + FLOOR)\n\n\ndef fit_gate(p, data):\n    q = gate_params()\n    m = {k: od.zeros(v.shape) for k, v in q.items()}\n    s = {k: od.full(v.shape, 1e-8) for k, v in q.items()}\n    start, span = od.used(), od.remaining()\n    worst, step = 0, 0\n    while od.remaining() > 2 * worst + 1_000_000:\n        before = od.used()\n        frac = (before - start) / span\n        z, y = data.batch(GATE_BATCH, GATE_T + PAD)\n        x = z[:, PAD:]\n        with od.no_grad():\n            p0 = base_probs(p, z, x)\n            stats = local_stats(z, x)\n        for again in range(1):\n            od.cross_entropy(blend(q, p0, stats, x), fold(y[:, PAD:])).backward()\n            step += 1\n            c1, c2 = GATE_LR * 0.5 * (1 + math.cos(math.pi * frac)) / (1 - 0.9**step), 1 / (1 - 0.99**step)\n            for k, v in q.items():\n                g = v.grad\n                if k in GATE_TABLES:\n                    s[k] = s[k] + g * g\n                    v.update(v - g * od.rsqrt(s[k]) * (GATE_TAB * (1 - 0.7 * frac)))\n                    v.grad = None\n                    continue\n                m[k] = m[k] * 0.9 + g * 0.1\n                s[k] = s[k] * 0.99 + g * g * 0.01\n                v.update(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n                v.grad = None\n        worst = max(worst, od.used() - before)\n    return q\n\n\ndef fit_tables(data, stop):\n    p = init_params()\n    tables = {f\"t{k}\": e for k, e in enumerate(EVERY)}\n    m = {k: od.zeros(v.shape) for k, v in p.items() if k not in tables}\n    s = {k: od.full(v.shape, 1e-8) for k, v in p.items()}\n    cold = history_masks(WINDOW)\n    start, span = od.used(), od.remaining() - stop\n    worst, step = 0, 0\n    while od.remaining() - stop > 2 * worst + 1_000_000:\n        before = od.used()\n        frac = (before - start) / span\n        sched = frac / WARMUP if frac < WARMUP else 0.5 * (1 + math.cos(math.pi * (frac - WARMUP) / (1 - WARMUP)))\n        z, y = data.batch(BATCH, WINDOW + PAD)\n        step += 1\n        masks = cold if step % COLD_EVERY == 0 else None\n        live = [frac < FULL or step % e == 0 for e in SAMPLE]\n        od.cross_entropy(mix(p, order_rows(z), masks, live), fold(y[:, PAD:])).backward()\n        c1, c2 = LR_MIX * sched / (1 - 0.9**step), 1 / (1 - 0.99**step)\n        lrt = LR_TABLE * min(1.0, frac / WARMUP) * (1 - (1 - LR_TAIL) * frac)\n        for k, v in p.items():\n            g = v.grad\n            if k in tables:\n                if g is None or step % tables[k]:\n                    continue\n                s[k] = s[k] + g * g\n                v.update(v - g * od.rsqrt(s[k]) * lrt)\n            else:\n                m[k] = m[k] * 0.9 + g * 0.1\n                s[k] = s[k] * 0.99 + g * g * 0.01\n                v.update(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n            v.grad = None\n        worst = max(worst, od.used() - before)\n    return p\n\n\ndef train(data):\n    p = fit_tables(data, od.remaining() * GATE_SHARE)\n    return p | fit_gate(p, data)\n", "numLines": 294, "startLine": 1, "totalLines": 294}}, "tool_result_meta": [{"id": "toolu_017KcMGeXm7uK5FkTgjLKN1u", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "rule"}}]}
{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01PEgUU8xyXWwG7deygnWdNR", "type": "tool_result", "content": "1\t\"\"\"Rerun an entry on fresh seeds and score it. This file is the referee.\n2\t\n3\t    python verify.py entries/gpt/train.py                         # 8 fresh seeds, scored on the test split\n4\t    python verify.py entries/gpt/train.py --seeds 2               # 2 fresh seeds\n5\t    python verify.py entries/mine/train.py --seeds 11,12 --split dev\n6\t    python verify.py entries/mine/train.py --against records/current.json\n7\t    python verify.py entries/mine/train.py --smoke                # seconds, for checking that an entry runs\n8\t\n9\tWhat a run guarantees:\n10\t  1. The source passes static rules. It imports only odometer and math, and it can name only the engine's public API,\n11\t     math, and plain container methods. No try, class, global, match, decorator or attribute assignment (except\n12\t     x.grad = None), and no module-level state beyond constants. Literals and syntax nodes are rationed, so a table\n13\t     cannot be smuggled in the source.\n14\t  2. train() runs in its own process with one BLAS thread, under the training budget, with the verifier's seed. That\n15\t     process never loads held-out bytes. A run that lets BudgetExhausted escape is void.\n16\t  3. Python work outside the engine is counted, not timed: entry lines and jumps are capped. One C call counts once\n17\t     however long it runs (a sum over a long range, big-integer arithmetic); that work has only the rationed item()\n18\t     reads to learn from, and the wall limit ends it.\n19\t  4. Scoring runs in a second, fresh process. forward() sees held-out inputs, never targets, and its compute per byte\n20\t     is capped. Every call gets a fresh params dict and fresh tensors, so no state survives between calls. A quarter\n21\t     of the windows get a twin whose bytes after a random cut come from another window; a shuffle puts nearly all twins\n22\t     in other batches. Logits before the cut must match, which catches forward() looking ahead or across rows.\n23\t  5. Seeds are drawn fresh unless given, and written to the log, so anyone can rerun the exact runs.\n24\t\"\"\"\n25\t\n26\timport argparse\n27\timport ast\n28\timport builtins\n29\timport hashlib\n30\timport json\n31\timport math\n32\timport os\n33\timport pathlib\n34\timport platform\n35\timport secrets\n36\timport subprocess\n37\timport sys\n38\timport tempfile\n39\timport time\n40\timport types\n41\tfrom concurrent.futures import ThreadPoolExecutor\n42\t\n43\tROOT = pathlib.Path(__file__).resolve().parent\n44\tsys.path.insert(0, str(ROOT))\n45\t\n46\timport stats  # noqa: E402\n47\t\n48\tTRACK = {\n49\t    \"version\": \"odometer-v3\",\n50\t    \"train_budget\": 40_000_000_000,  # ticks for everything train() does; about 80 s on a 4-core VM, 25 s on an M4\n51\t    \"eval_ticks_per_byte\": 50_000,  # forward() price cap per scored byte\n52\t    \"param_cap\": 1 << 22,  # floats in the returned parameters, plus characters in their names\n53\t    \"source_cap\": 64 * 1024,  # bytes of train.py\n54\t    \"literal_cap\": 4096,  # bytes of literals, keyword names and function names in train.py\n55\t    \"node_cap\": 8192,  # syntax nodes in train.py; a table spelled in variable names has no literals to count\n56\t    \"python_lines\": 20_000_000,  # entry lines and jumps per process\n57\t    \"eval_context\": 512,\n58\t    \"eval_batch\": 16,\n59\t    \"eval_windows\": 1024,  # windows of eval_context bytes per held-out split\n60\t    \"twin_fraction\": 0.25,\n61\t    \"twin_positions\": 32,\n62\t    \"twin_tolerance\": 1e-4,  # max |log p| difference between twins, in nats; a leak this small gains 1.4e-4 bits per byte\n63\t    \"item_cap\": 20_000,  # item() reads in train()\n64\t    \"wall_limit_seconds\": 3600,  # only catches hangs; it never decides a score\n65\t}\n66\tSMOKE = {\"train_budget\": 2_000_000_000, \"eval_windows\": 32, \"wall_limit_seconds\": 300}\n67\tRECORD_ALPHA = 0.01\n68\tRECORD_MARGIN = 0.002  # bits per byte a new record must clear on top of the significance test\n69\tLOW_VARIANCE_RATIO = 0.3  # seed SD below this fraction of the incumbent's gets flagged for a human look\n70\tTHREAD_VARS = (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"VECLIB_MAXIMUM_THREADS\", \"NUMEXPR_NUM_THREADS\")\n71\t\n72\t# ---------------------------------------------------------------- static rules\n73\t\n74\tALLOWED_IMPORTS = {\"odometer\", \"math\"}\n75\tALLOWED_BUILTINS = {\n76\t    \"abs\", \"all\", \"any\", \"bool\", \"dict\", \"divmod\", \"enumerate\", \"float\", \"int\", \"isinstance\", \"len\", \"list\", \"max\",\n77\t    \"min\", \"pow\", \"print\", \"range\", \"reversed\", \"round\", \"set\", \"sorted\", \"str\", \"sum\", \"tuple\", \"zip\",\n78\t    \"True\", \"False\", \"None\",\n79\t}\n80\t# math without its functions over sequences and big integers, which do unbounded numeric work in one counted line\n81\tMATH_NAMES = {n for n in dir(math) if not n.startswith(\"_\")} - {\n82\t    \"comb\", \"dist\", \"factorial\", \"fsum\", \"gcd\", \"hypot\", \"isqrt\", \"lcm\", \"perm\", \"prod\", \"sumprod\",\n83\t}\n84\tCONTAINER_ATTRS = {\n85\t    \"append\", \"extend\", \"insert\", \"pop\", \"remove\", \"reverse\", \"sort\", \"index\", \"count\", \"clear\", \"copy\", \"items\", \"keys\",\n86\t    \"values\", \"get\", \"setdefault\", \"update\", \"join\", \"split\", \"strip\", \"startswith\", \"endswith\",\n87\t}\n88\tBANNED_NODES = (\n89\t    ast.ClassDef, ast.AsyncFunctionDef, ast.AsyncFor, ast.AsyncWith, ast.Await, ast.Try, ast.TryStar, ast.Match,\n90\t    ast.Global, ast.Nonlocal, ast.Delete, ast.TypeAlias,\n91\t)\n92\t\n93\t\n94\tdef allowed_attrs():\n95\t    import odometer as od\n96\t\n97\t    engine = {n for n in dir(od) if not n.startswith(\"_\")} - {\"Tensor\"}\n98\t    tensor = {n for n in dir(od.Tensor) if not n.startswith(\"_\")}\n99\t    return engine, engine | tensor | {\"batch\", \"num_bytes\"} | MATH_NAMES | CONTAINER_ATTRS\n100\t\n101\t\n102\tdef is_constant_expr(node):\n103\t    return all(isinstance(n, (ast.Constant, ast.Tuple, ast.UnaryOp, ast.BinOp, ast.Name, ast.Load, ast.operator, ast.unaryop))\n104\t               for n in ast.walk(node))\n105\t\n106\t\n107\tdef literal_bytes(tree):\n108\t    \"\"\"Everything in the source an entry can read back as data. dict(name=1) and str(function) turn names into strings.\"\"\"\n109\t    docstrings = {id(n.body[0].value) for n in ast.walk(tree)\n110\t                  if isinstance(n, (ast.Module, ast.FunctionDef)) and n.body and isinstance(n.body[0], ast.Expr)\n111\t                  and isinstance(n.body[0].value, ast.Constant) and isinstance(n.body[0].value.value, str)}\n112\t\n113\t    def size(v):\n114\t        if isinstance(v, str):\n115\t            return len(v.encode(\"utf-8\", \"surrogatepass\"))\n116\t        return len(v) if isinstance(v, bytes) else max(8, v.bit_length() // 8) if isinstance(v, int) else 8\n117\t\n118\t    total = 0\n119\t    for n in ast.walk(tree):\n120\t        if isinstance(n, ast.Constant) and id(n) not in docstrings:\n121\t            total += size(n.value)\n122\t        elif isinstance(n, ast.keyword) and n.arg:\n123\t            total += size(n.arg)\n124\t        elif isinstance(n, ast.FunctionDef):\n125\t            total += size(n.name)\n126\t    return total\n127\t\n128\t\n129\tdef static_problems(src, track=TRACK):\n130\t    if len(src.encode()) > track[\"source_cap\"]:\n131\t        return [f\"source is over {track['source_cap']} bytes\"]\n132\t    try:\n133\t        tree = ast.parse(src)\n134\t    except (SyntaxError, MemoryError, RecursionError) as e:\n135\t        return [f\"syntax error: {e}\"]\n136\t    engine, attrs = allowed_attrs()\n137\t    forbidden = set(dir(builtins)) - ALLOWED_BUILTINS\n138\t    nodes = list(ast.walk(tree))\n139\t    clears_grad = {id(t) for n in nodes if isinstance(n, ast.Assign) and isinstance(n.value, ast.Constant) and n.value.value is None\n140\t                   for t in n.targets if isinstance(t, ast.Attribute) and t.attr == \"grad\"}\n141\t    problems = []\n142\t    for node in nodes:\n143\t        line = getattr(node, \"lineno\", 0)\n144\t        if isinstance(node, BANNED_NODES):\n145\t            problems.append(f\"line {line}: {type(node).__name__} is not allowed\")\n146\t        elif isinstance(node, ast.Import):\n147\t            problems += [f\"line {line}: import {a.name}\" for a in node.names if a.name not in ALLOWED_IMPORTS]\n148\t        elif isinstance(node, ast.ImportFrom):\n149\t            if node.level or node.module not in ALLOWED_IMPORTS:\n150\t                problems.append(f\"line {line}: from {'.' * node.level}{node.module or ''} import\")\n151\t            else:\n152\t                names = engine if node.module == \"odometer\" else MATH_NAMES\n153\t                problems += [f\"line {line}: from {node.module} import {a.name}\" for a in node.names if a.name not in names]\n154\t        elif isinstance(node, ast.alias):\n155\t            if node.asname and node.asname.startswith(\"_\"):  # import math as __builtins__ swaps the builtins table\n156\t                problems.append(f\"line {line}: {node.asname} starts with an underscore\")\n157\t        elif isinstance(node, ast.Attribute):\n158\t            if node.attr not in attrs:\n159\t                problems.append(f\"line {line}: .{node.attr} is not on the allowed list\")\n160\t            if not isinstance(node.ctx, ast.Load) and id(node) not in clears_grad:\n161\t                problems.append(f\"line {line}: assigning to .{node.attr}\")\n162\t        elif isinstance(node, ast.Name):\n163\t            if node.id.startswith(\"_\") and node.id != \"_\":\n164\t                problems.append(f\"line {line}: {node.id} starts with an underscore\")\n165\t            elif node.id in forbidden:\n166\t                problems.append(f\"line {line}: builtin {node.id} is not on the allowed list\")\n167\t        elif isinstance(node, (ast.FunctionDef, ast.Lambda)):\n168\t            if isinstance(node, ast.FunctionDef):\n169\t                if node.name.startswith(\"_\"):\n170\t                    problems.append(f\"line {line}: {node.name} starts with an underscore\")\n171\t                if node.decorator_list:  # a decorator is a call at module level, so it could build state that persists\n172\t                    problems.append(f\"line {line}: decorators are not allowed\")\n173\t                if node.returns and not is_constant_expr(node.returns):\n174\t                    problems.append(f\"line {line}: an annotation must be a constant\")\n175\t            if not all(is_constant_expr(d) for d in [*node.args.defaults, *node.args.kw_defaults] if d is not None):\n176\t                problems.append(f\"line {line}: a default argument must be a constant\")\n177\t        elif isinstance(node, ast.arg) and node.annotation and not is_constant_expr(node.annotation):\n178\t            problems.append(f\"line {line}: an annotation must be a constant\")  # annotations run once, at def time\n179\t    for node in tree.body:\n180\t        fine = isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef))\n181\t        fine |= isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n182\t        fine |= (isinstance(node, ast.Assign) and all(isinstance(t, ast.Name) for t in node.targets) and is_constant_expr(node.value))\n183\t        if not fine:\n184\t            problems.append(f\"line {node.lineno}: module level allows only imports, defs and constants\")\n185\t    if literal_bytes(tree) > track[\"literal_cap\"]:\n186\t        problems.append(f\"literals total {literal_bytes(tree)} bytes, over the cap of {track['literal_cap']}\")\n187\t    if len(nodes) > track[\"node_cap\"]:\n188\t        problems.append(f\"source has {len(nodes)} syntax nodes, over the cap of {track['node_cap']}\")\n189\t    top = {n.name for n in tree.body if isinstance(n, ast.FunctionDef)}\n190\t    problems += [f\"no top-level {f}()\" for f in (\"train\", \"forward\") if f not in top]\n191\t    return problems\n192\t\n193\t\n194\tdef load_entry(path, track):\n195\t    \"\"\"Execute the entry with a builtins table that has no way out of the engine.\"\"\"\n196\t    src = pathlib.Path(path).read_text(encoding=\"utf-8\")\n197\t    problems = static_problems(src, track)\n198\t    if problems:\n199\t        raise SystemExit(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n200\t\n201\t    def guarded_import(name, globals=None, locals=None, fromlist=(), level=0):\n202\t        if level or name not in ALLOWED_IMPORTS:\n203\t            raise ImportError(f\"import of {name} is not allowed\")\n204\t        return builtins.__import__(name, globals, locals, fromlist, level)\n205\t\n206\t    safe = {k: getattr(builtins, k) for k in ALLOWED_BUILTINS}\n207\t    safe[\"__import__\"] = guarded_import\n208\t    module = types.ModuleType(\"entry\")\n209\t    module.__dict__[\"__builtins__\"] = safe\n210\t    exec(compile(src, str(path), \"exec\"), module.__dict__)\n211\t    return module\n212\t\n213\t\n214\tdef peak_rss_mb():\n215\t    import resource\n216\t\n217\t    kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n218\t    return kb / 1024 ** (2 if sys.platform == \"darwin\" else 1)\n219\t\n220\t\n221\tdef count_python_work(entry, cap, violation):\n222\t    \"\"\"Deterministic fence on Python outside the engine: every line and jump of the entry costs one count.\"\"\"\n223\t    mon, events = sys.monitoring, sys.monitoring.events\n224\t    seen = [0]\n225\t\n226\t    def on_event(code, *rest):\n227\t        if code.co_filename != entry:\n228\t            return mon.DISABLE\n229\t        seen[0] += 1\n230\t        if seen[0] > cap:\n231\t            raise violation(f\"more than {cap} Python lines and jumps in the entry\")\n232\t\n233\t    mon.use_tool_id(mon.PROFILER_ID, \"odometer\")\n234\t    mon.register_callback(mon.PROFILER_ID, events.LINE, on_event)\n235\t    mon.register_callback(mon.PROFILER_ID, events.JUMP, on_event)\n236\t    mon.set_events(mon.PROFILER_ID, events.LINE | events.JUMP)\n237\t    return seen\n238\t\n239\t\n240\t# ---------------------------------------------------------------- the two child processes\n241\t\n242\t\n243\tdef child_train(entry, seed, out):\n244\t    import numpy as np\n245\t\n246\t    import odometer as od\n247\t    from odometer import _data, _engine\n248\t\n249\t    out = pathlib.Path(out)\n250\t    track = json.loads((out / \"track.json\").read_text())\n251\t    _engine._M.reset(track[\"train_budget\"], seed, item_cap=track[\"item_cap\"])\n252\t    data = _data.TrainData()\n253\t    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n254\t    t0 = time.perf_counter()\n255\t    status, params = \"ok\", None\n256\t    try:\n257\t        params = load_entry(entry, track).train(data)\n258\t    except od.BudgetExhausted as e:\n259\t        status = f\"void: BudgetExhausted escaped train() ({e})\"\n260\t    except od.RuleViolation as e:\n261\t        status = f\"void: rule violation: {e}\"\n262\t    seconds = time.perf_counter() - t0\n263\t    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n264\t    if status == \"ok\":\n265\t        if not isinstance(params, dict) or not all(isinstance(k, str) and type(v) is od.Tensor for k, v in params.items()):\n266\t            status = \"void: train() must return a dict of name -> Tensor\"\n267\t        elif any(v.is_int for v in params.values()):\n268\t            status = \"void: parameters must be float tensors\"\n269\t        elif sum(v.size + len(k) for k, v in params.items()) > track[\"param_cap\"]:\n270\t            status = f\"void: more than {track['param_cap']} parameters, with one more per character of their names\"\n271\t        else:\n272\t            np.savez(out / \"params.npz\", **{f\"p{i}\": v._d for i, v in enumerate(params.values())})\n273\t            (out / \"names.json\").write_text(json.dumps(list(params)))\n274\t    report = {\"status\": status, \"train_ticks\": _engine._M.used, \"train_seconds\": seconds, \"item_reads\": _engine._M.items,\n275\t              \"train_python_lines\": lines[0], \"peak_rss_mb\": peak_rss_mb(), \"params\": sum(v.size for v in params.values()) if status == \"ok\" else None}\n276\t    (out / \"train.json\").write_text(json.dumps(report))\n277\t\n278\t\n279\tdef child_eval(entry, seed, split, out):\n280\t    import numpy as np\n281\t\n282\t    import odometer as od\n283\t    from odometer import _data, _engine\n284\t\n285\t    out = pathlib.Path(out)\n286\t    track = json.loads((out / \"track.json\").read_text())\n287\t    C, B = track[\"eval_context\"], track[\"eval_batch\"]\n288\t    windows = _data.heldout_windows(split, C, track[\"eval_windows\"])\n289\t    n = len(windows)\n290\t    rng = np.random.default_rng([seed, 2])\n291\t    twins = np.sort(rng.choice(n, int(n * track[\"twin_fraction\"]), replace=False))\n292\t    cuts = rng.integers(1, C, size=twins.size)\n293\t    donors = windows[rng.integers(0, n, size=twins.size)]\n294\t    rows = np.concatenate([windows[:, :C], windows[twins, :C]])\n295\t    probe = []\n296\t    for j, (cut, donor) in enumerate(zip(cuts, donors)):\n297\t        rows[n + j, cut:] = donor[cut:C]\n298\t        last = np.arange(max(0, cut - 8), cut)  # a look-ahead leak shows first just before the cut\n299\t        probe.append(np.union1d(last, rng.choice(cut, min(cut, track[\"twin_positions\"]), replace=False)))\n300\t    probe_rows = {int(r): j for j, r in enumerate(twins)} | {n + j: j for j in range(twins.size)}\n301\t    order = rng.permutation(len(rows))\n302\t\n303\t    scored_bytes = len(rows) * C\n304\t    _engine._M.reset(track[\"eval_ticks_per_byte\"] * scored_bytes, seed, mode=\"eval\")\n305\t    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n306\t    t0 = time.perf_counter()\n307\t    status = \"ok\"\n308\t    nll = np.zeros(n)\n309\t    seen = {}\n310\t    try:\n311\t        module = load_entry(entry, track)\n312\t        names = json.loads((out / \"names.json\").read_text())\n313\t        stored = np.load(out / \"params.npz\")\n314\t        arrays = {name: stored[f\"p{i}\"] for i, name in enumerate(names)}\n315\t        for a in arrays.values():\n316\t            a.setflags(write=False)\n317\t        for start in range(0, len(rows), B):\n318\t            idx = order[start : start + B]\n319\t            logits = module.forward({k: od.Tensor(a) for k, a in arrays.items()}, od.Tensor(rows[idx].astype(np.int32)))\n320\t            if type(logits) is not od.Tensor or logits.is_int or logits.shape != (len(idx), C, od.VOCAB):\n321\t                raise od.RuleViolation(f\"forward() must return float logits of shape (batch, {C}, {od.VOCAB})\")\n322\t            z = logits._d.astype(np.float64)\n323\t            if not np.isfinite(z).all():\n324\t                raise od.RuleViolation(\"forward() returned non-finite logits\")\n325\t            lp = z - z.max(-1, keepdims=True)\n326\t            lp -= np.log(np.exp(lp).sum(-1, keepdims=True))\n327\t            for b, r in enumerate(idx):\n328\t                if r < n:\n329\t                    nll[r] = -lp[b, np.arange(C), windows[r, 1:]].sum()\n330\t                if int(r) in probe_rows:\n331\t                    j = probe_rows[int(r)]\n332\t                    seen.setdefault(j, []).append(lp[b, probe[j]])\n333\t    except od.BudgetExhausted:\n334\t        status = f\"void: forward() cost more than {track['eval_ticks_per_byte']:,} ticks per byte\"\n335\t    except od.RuleViolation as e:\n336\t        status = f\"void: rule violation: {e}\"\n337\t    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n338\t    twin_diff = max((float(np.abs(a - b).max()) for a, b in seen.values()), default=0.0) if status == \"ok\" else None\n339\t    if status == \"ok\" and twin_diff > track[\"twin_tolerance\"]:\n340\t        status = f\"void: twin check failed (logits before the cut moved by {twin_diff:.2e} nats)\"\n341\t    report = {\"status\": status, \"split\": split, \"bpb\": float(nll.sum() / (n * C) / np.log(2)) if status == \"ok\" else None,\n342\t              \"eval_ticks_per_byte\": _engine._M.used / scored_bytes, \"twin_max_diff\": twin_diff,\n343\t              \"eval_python_lines\": lines[0], \"eval_seconds\": time.perf_counter() - t0}\n344\t    (out / \"eval.json\").write_text(json.dumps(report))\n345\t\n346\t\n347\t# ---------------------------------------------------------------- the parent\n348\t\n349\t\n350\tdef run_seed(entry, seed, split, track, keep):\n351\t    env = {\"PATH\": os.environ.get(\"PATH\", \"\"), **{v: \"1\" for v in THREAD_VARS}}\n352\t    with tempfile.TemporaryDirectory() as tmp:\n353\t        (pathlib.Path(tmp) / \"track.json\").write_text(json.dumps(track))\n354\t        result = {\"seed\": seed}\n355\t        for stage, extra in ((\"train\", []), (\"eval\", [split])):\n356\t            cmd = [sys.executable, \"-I\", str(ROOT / \"verify.py\"), f\"--child-{stage}\", str(entry), str(seed), *extra, tmp]\n357\t            log = keep / f\"seed-{seed}-{stage}.log\"\n358\t            try:\n359\t                with open(log, \"wb\") as sink:\n360\t                    subprocess.run(cmd, cwd=tmp, env=env, stdout=sink, stderr=subprocess.STDOUT, timeout=track[\"wall_limit_seconds\"])\n361\t            except subprocess.TimeoutExpired:\n362\t                result[\"status\"] = f\"void: {stage} process passed the wall limit\"\n363\t                return result\n364\t            path = pathlib.Path(tmp) / f\"{stage}.json\"\n365\t            if not path.exists():\n366\t                result[\"status\"] = f\"void: {stage} process crashed (see {log.name})\"\n367\t                return result\n368\t            result |= json.loads(path.read_text())\n369\t            if result[\"status\"] != \"ok\":\n370\t                return result\n371\t        return result\n372\t\n373\t\n374\tdef machine():\n375\t    import numpy as np\n376\t\n377\t    blas = np.show_config(mode=\"dicts\")[\"Build Dependencies\"][\"blas\"]\n378\t    return {\"platform\": platform.platform(), \"machine\": platform.machine(), \"python\": platform.python_version(),\n379\t            \"numpy\": np.__version__, \"blas\": f\"{blas.get('name')} {blas.get('version')}\", \"cpus\": os.cpu_count()}\n380\t\n381\t\n382\tdef code_hash():\n383\t    h = hashlib.sha256()\n384\t    for p in [ROOT / \"verify.py\", *sorted((ROOT / \"odometer\").glob(\"*.py\"))]:\n385\t        h.update(p.read_bytes())\n386\t    return h.hexdigest()\n387\t\n388\t\n389\tdef run_batch(entry, seeds, split, track, logs, jobs, label=\"\"):\n390\t    with ThreadPoolExecutor(jobs) as pool:\n391\t        results = []\n392\t        for r in pool.map(lambda s: run_seed(entry, s, split, track, logs), seeds):\n393\t            results.append(r)\n394\t            if r[\"status\"] == \"ok\":\n395\t                print(f\"  seed {r['seed']:>10}  {split} bpb {r['bpb']:.4f}  train {r['train_ticks']:.3e} ticks  \"\n396\t                      f\"{r['train_seconds']:6.1f} s  eval {r['eval_ticks_per_byte']:,.0f} ticks/byte  \"\n397\t                      f\"twins {r['twin_max_diff']:.1e}{label}\", flush=True)\n398\t            else:\n399\t                print(f\"  seed {r['seed']:>10}  {r['status']}{label}\", flush=True)\n400\t    return results\n401\t\n402\t\n403\tdef fresh_seeds(n):\n404\t    return [secrets.randbits(31) for _ in range(n)]\n405\t\n406\t\n407\tdef judge(bpbs, record_bpbs):\n408\t    \"\"\"Does this batch beat the record by more than the margin? Welch, one-sided, on the verifier's own seeds.\"\"\"\n409\t    w = stats.welch(bpbs, [b - RECORD_MARGIN for b in record_bpbs])\n410\t    plain = stats.welch(bpbs, record_bpbs)\n411\t    return {\"gain\": -plain[\"diff\"], \"ci95\": plain[\"ci95\"], \"df\": w[\"df\"], \"p_beyond_margin\": w[\"p_one_sided\"],\n412\t            \"passes\": w[\"p_one_sided\"] < RECORD_ALPHA}\n413\t\n414\t\n415\tdef main():\n416\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n417\t    ap.add_argument(\"entry\")\n418\t    ap.add_argument(\"--seeds\", default=\"8\", help=\"a count of fresh seeds, or a comma list to rerun exact seeds ('11,' is seed 11)\")\n419\t    ap.add_argument(\"--split\", default=\"test\", choices=(\"dev\", \"test\"))\n420\t    ap.add_argument(\"--jobs\", type=int, default=0, help=\"seeds in parallel (default: min(seeds, cpus))\")\n421\t    ap.add_argument(\"--against\", help=\"a record log; tests whether this entry beats it, then confirms on new seeds\")\n422\t    ap.add_argument(\"--smoke\", action=\"store_true\", help=\"a tiny budget and a few windows; the number is not a score\")\n423\t    ap.add_argument(\"--out\", help=\"where to write the log (default runs/<entry>-<time>.json)\")\n424\t    args = ap.parse_args()\n425\t\n426\t    track = {**TRACK, **SMOKE} if args.smoke else TRACK\n427\t    entry = pathlib.Path(args.entry).resolve()\n428\t    src = entry.read_text(encoding=\"utf-8\")\n429\t    problems = static_problems(src, track)\n430\t    if problems:\n431\t        print(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n432\t        sys.exit(2)\n433\t    seeds = [int(s) for s in args.seeds.split(\",\") if s] if \",\" in args.seeds else fresh_seeds(int(args.seeds))\n434\t    name = entry.parent.name if entry.name == \"train.py\" else entry.stem\n435\t    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\n436\t    out = pathlib.Path(args.out) if args.out else ROOT / \"runs\" / f\"{name}-{stamp}.json\"\n437\t    logs = out.with_suffix(\"\")\n438\t    logs.mkdir(parents=True, exist_ok=True)\n439\t    jobs = args.jobs or max(1, min(len(seeds), os.cpu_count() or 1))\n440\t    print(f\"{name}: {len(seeds)} seeds on {args.split}, {jobs} at a time, budget {track['train_budget']:.1e} ticks\"\n441\t          + (\" (smoke run: not a score)\" if args.smoke else \"\"), flush=True)\n442\t\n443\t    t0 = time.time()\n444\t    results = run_batch(entry, seeds, args.split, track, logs, jobs)\n445\t    ok = [r[\"bpb\"] for r in results if r[\"status\"] == \"ok\"]\n446\t    log = {\"entry\": str(entry.relative_to(ROOT)) if entry.is_relative_to(ROOT) else entry.name,\n447\t           \"sha256\": hashlib.sha256(src.encode()).hexdigest(), \"code_sha256\": code_hash(), \"track\": track,\n448\t           \"split\": args.split, \"smoke\": args.smoke, \"machine\": machine(), \"started\": stamp, \"seeds\": results}\n449\t    if len(ok) == len(results) and len(ok) >= 2:\n450\t        m, half = stats.ci95(ok)\n451\t        log[\"summary\"] = {\"mean_bpb\": m, \"ci95\": half, \"sd\": stats.mean_sd(ok)[1], \"n\": len(ok)}\n452\t        print(f\"  mean {m:.4f} +- {half:.4f} bpb (95% CI, n={len(ok)}, sd {log['summary']['sd']:.4f})\")\n453\t    elif len(ok) != len(results):\n454\t        print(\"  void: at least one seed failed, so the entry has no score\")\n455\t    elif ok:\n456\t        print(f\"  {ok[0]:.4f} bpb on one seed (use at least 2 for an interval)\")\n457\t\n458\t    if args.against and \"summary\" in log:\n459\t        inc = json.loads(pathlib.Path(args.against).read_text())\n460\t        if inc[\"split\"] != args.split:\n461\t            raise SystemExit(\"the record was scored on a different split\")\n462\t        incumbent = [r[\"bpb\"] for r in inc.get(\"confirmation\", inc[\"seeds\"])]\n463\t        stage1 = judge(ok, incumbent)\n464\t        verdict = {\"against\": args.against, \"margin\": RECORD_MARGIN, \"alpha\": RECORD_ALPHA, \"stage1\": stage1, \"record\": False}\n465\t        print(f\"  gain over the record: {stage1['gain']:+.4f} +- {stage1['ci95']:.4f} bpb, p = {stage1['p_beyond_margin']:.2g} \"\n466\t              f\"(beyond a margin of {RECORD_MARGIN})\")\n467\t        if stats.mean_sd(ok)[1] < LOW_VARIANCE_RATIO * stats.mean_sd(incumbent)[1]:\n468\t            verdict[\"flag\"] = \"seed SD is far below the incumbent's; read the entry for a fixed init or data order\"\n469\t            print(f\"  flag: {verdict['flag']}\")\n470\t        if stage1[\"passes\"]:\n471\t            print(\"  passed; confirming on new seeds\", flush=True)\n472\t            second = run_batch(entry, fresh_seeds(len(seeds)), args.split, track, logs, jobs, label=\"  (confirmation)\")\n473\t            log[\"confirmation\"] = second\n474\t            good = [r[\"bpb\"] for r in second if r[\"status\"] == \"ok\"]\n475\t            if len(good) == len(second):\n476\t                stage2 = judge(good, incumbent)\n477\t                verdict[\"stage2\"] = stage2\n478\t                verdict[\"record\"] = stage2[\"passes\"]\n479\t                print(f\"  confirmation: {stage2['gain']:+.4f} +- {stage2['ci95']:.4f} bpb, p = {stage2['p_beyond_margin']:.2g}\")\n480\t        print(\"  NEW RECORD\" if verdict[\"record\"] else \"  not a record\")\n481\t        log[\"verdict\"] = verdict\n482\t    log[\"wall_seconds\"] = time.time() - t0\n483\t    out.parent.mkdir(parents=True, exist_ok=True)\n484\t    out.write_text(json.dumps(log, indent=1))\n485\t    print(f\"  log: {out.relative_to(ROOT) if out.is_relative_to(ROOT) else out}\")\n486\t    if len(ok) != len(results):\n487\t        sys.exit(1)\n488\t\n489\t\n490\tif __name__ == \"__main__\":\n491\t    if len(sys.argv) > 1 and sys.argv[1] == \"--child-train\":\n492\t        child_train(sys.argv[2], int(sys.argv[3]), sys.argv[4])\n493\t    elif len(sys.argv) > 1 and sys.argv[1] == \"--child-eval\":\n494\t        child_eval(sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5])\n495\t    else:\n496\t        main()\n497\t"}]}, "parent_tool_use_id": null, "session_id": "507db3bc-24cf-4b4c-ac88-8eb6bce6499d", "uuid": "6c4837b4-099a-43ca-9f5c-ed2870889835", "timestamp": "2026-11-02T20:15:37.945Z", "tool_use_result": {"type": "text", "file": {"filePath": "/home/user/att/attempt-06/verify.py", "content": "\"\"\"Rerun an entry on fresh seeds and score it. This file is the referee.\n\n    python verify.py entries/gpt/train.py                         # 8 fresh seeds, scored on the test split\n    python verify.py entries/gpt/train.py --seeds 2               # 2 fresh seeds\n    python verify.py entries/mine/train.py --seeds 11,12 --split dev\n    python verify.py entries/mine/train.py --against records/current.json\n    python verify.py entries/mine/train.py --smoke                # seconds, for checking that an entry runs\n\nWhat a run guarantees:\n  1. The source passes static rules. It imports only odometer and math, and it can name only the engine's public API,\n     math, and plain container methods. No try, class, global, match, decorator or attribute assignment (except\n     x.grad = None), and no module-level state beyond constants. Literals and syntax nodes are rationed, so a table\n     cannot be smuggled in the source.\n  2. train() runs in its own process with one BLAS thread, under the training budget, with the verifier's seed. That\n     process never loads held-out bytes. A run that lets BudgetExhausted escape is void.\n  3. Python work outside the engine is counted, not timed: entry lines and jumps are capped. One C call counts once\n     however long it runs (a sum over a long range, big-integer arithmetic); that work has only the rationed item()\n     reads to learn from, and the wall limit ends it.\n  4. Scoring runs in a second, fresh process. forward() sees held-out inputs, never targets, and its compute per byte\n     is capped. Every call gets a fresh params dict and fresh tensors, so no state survives between calls. A quarter\n     of the windows get a twin whose bytes after a random cut come from another window; a shuffle puts nearly all twins\n     in other batches. Logits before the cut must match, which catches forward() looking ahead or across rows.\n  5. Seeds are drawn fresh unless given, and written to the log, so anyone can rerun the exact runs.\n\"\"\"\n\nimport argparse\nimport ast\nimport builtins\nimport hashlib\nimport json\nimport math\nimport os\nimport pathlib\nimport platform\nimport secrets\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport types\nfrom concurrent.futures import ThreadPoolExecutor\n\nROOT = pathlib.Path(__file__).resolve().parent\nsys.path.insert(0, str(ROOT))\n\nimport stats  # noqa: E402\n\nTRACK = {\n    \"version\": \"odometer-v3\",\n    \"train_budget\": 40_000_000_000,  # ticks for everything train() does; about 80 s on a 4-core VM, 25 s on an M4\n    \"eval_ticks_per_byte\": 50_000,  # forward() price cap per scored byte\n    \"param_cap\": 1 << 22,  # floats in the returned parameters, plus characters in their names\n    \"source_cap\": 64 * 1024,  # bytes of train.py\n    \"literal_cap\": 4096,  # bytes of literals, keyword names and function names in train.py\n    \"node_cap\": 8192,  # syntax nodes in train.py; a table spelled in variable names has no literals to count\n    \"python_lines\": 20_000_000,  # entry lines and jumps per process\n    \"eval_context\": 512,\n    \"eval_batch\": 16,\n    \"eval_windows\": 1024,  # windows of eval_context bytes per held-out split\n    \"twin_fraction\": 0.25,\n    \"twin_positions\": 32,\n    \"twin_tolerance\": 1e-4,  # max |log p| difference between twins, in nats; a leak this small gains 1.4e-4 bits per byte\n    \"item_cap\": 20_000,  # item() reads in train()\n    \"wall_limit_seconds\": 3600,  # only catches hangs; it never decides a score\n}\nSMOKE = {\"train_budget\": 2_000_000_000, \"eval_windows\": 32, \"wall_limit_seconds\": 300}\nRECORD_ALPHA = 0.01\nRECORD_MARGIN = 0.002  # bits per byte a new record must clear on top of the significance test\nLOW_VARIANCE_RATIO = 0.3  # seed SD below this fraction of the incumbent's gets flagged for a human look\nTHREAD_VARS = (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"VECLIB_MAXIMUM_THREADS\", \"NUMEXPR_NUM_THREADS\")\n\n# ---------------------------------------------------------------- static rules\n\nALLOWED_IMPORTS = {\"odometer\", \"math\"}\nALLOWED_BUILTINS = {\n    \"abs\", \"all\", \"any\", \"bool\", \"dict\", \"divmod\", \"enumerate\", \"float\", \"int\", \"isinstance\", \"len\", \"list\", \"max\",\n    \"min\", \"pow\", \"print\", \"range\", \"reversed\", \"round\", \"set\", \"sorted\", \"str\", \"sum\", \"tuple\", \"zip\",\n    \"True\", \"False\", \"None\",\n}\n# math without its functions over sequences and big integers, which do unbounded numeric work in one counted line\nMATH_NAMES = {n for n in dir(math) if not n.startswith(\"_\")} - {\n    \"comb\", \"dist\", \"factorial\", \"fsum\", \"gcd\", \"hypot\", \"isqrt\", \"lcm\", \"perm\", \"prod\", \"sumprod\",\n}\nCONTAINER_ATTRS = {\n    \"append\", \"extend\", \"insert\", \"pop\", \"remove\", \"reverse\", \"sort\", \"index\", \"count\", \"clear\", \"copy\", \"items\", \"keys\",\n    \"values\", \"get\", \"setdefault\", \"update\", \"join\", \"split\", \"strip\", \"startswith\", \"endswith\",\n}\nBANNED_NODES = (\n    ast.ClassDef, ast.AsyncFunctionDef, ast.AsyncFor, ast.AsyncWith, ast.Await, ast.Try, ast.TryStar, ast.Match,\n    ast.Global, ast.Nonlocal, ast.Delete, ast.TypeAlias,\n)\n\n\ndef allowed_attrs():\n    import odometer as od\n\n    engine = {n for n in dir(od) if not n.startswith(\"_\")} - {\"Tensor\"}\n    tensor = {n for n in dir(od.Tensor) if not n.startswith(\"_\")}\n    return engine, engine | tensor | {\"batch\", \"num_bytes\"} | MATH_NAMES | CONTAINER_ATTRS\n\n\ndef is_constant_expr(node):\n    return all(isinstance(n, (ast.Constant, ast.Tuple, ast.UnaryOp, ast.BinOp, ast.Name, ast.Load, ast.operator, ast.unaryop))\n               for n in ast.walk(node))\n\n\ndef literal_bytes(tree):\n    \"\"\"Everything in the source an entry can read back as data. dict(name=1) and str(function) turn names into strings.\"\"\"\n    docstrings = {id(n.body[0].value) for n in ast.walk(tree)\n                  if isinstance(n, (ast.Module, ast.FunctionDef)) and n.body and isinstance(n.body[0], ast.Expr)\n                  and isinstance(n.body[0].value, ast.Constant) and isinstance(n.body[0].value.value, str)}\n\n    def size(v):\n        if isinstance(v, str):\n            return len(v.encode(\"utf-8\", \"surrogatepass\"))\n        return len(v) if isinstance(v, bytes) else max(8, v.bit_length() // 8) if isinstance(v, int) else 8\n\n    total = 0\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Constant) and id(n) not in docstrings:\n            total += size(n.value)\n        elif isinstance(n, ast.keyword) and n.arg:\n            total += size(n.arg)\n        elif isinstance(n, ast.FunctionDef):\n            total += size(n.name)\n    return total\n\n\ndef static_problems(src, track=TRACK):\n    if len(src.encode()) > track[\"source_cap\"]:\n        return [f\"source is over {track['source_cap']} bytes\"]\n    try:\n        tree = ast.parse(src)\n    except (SyntaxError, MemoryError, RecursionError) as e:\n        return [f\"syntax error: {e}\"]\n    engine, attrs = allowed_attrs()\n    forbidden = set(dir(builtins)) - ALLOWED_BUILTINS\n    nodes = list(ast.walk(tree))\n    clears_grad = {id(t) for n in nodes if isinstance(n, ast.Assign) and isinstance(n.value, ast.Constant) and n.value.value is None\n                   for t in n.targets if isinstance(t, ast.Attribute) and t.attr == \"grad\"}\n    problems = []\n    for node in nodes:\n        line = getattr(node, \"lineno\", 0)\n        if isinstance(node, BANNED_NODES):\n            problems.append(f\"line {line}: {type(node).__name__} is not allowed\")\n        elif isinstance(node, ast.Import):\n            problems += [f\"line {line}: import {a.name}\" for a in node.names if a.name not in ALLOWED_IMPORTS]\n        elif isinstance(node, ast.ImportFrom):\n            if node.level or node.module not in ALLOWED_IMPORTS:\n                problems.append(f\"line {line}: from {'.' * node.level}{node.module or ''} import\")\n            else:\n                names = engine if node.module == \"odometer\" else MATH_NAMES\n                problems += [f\"line {line}: from {node.module} import {a.name}\" for a in node.names if a.name not in names]\n        elif isinstance(node, ast.alias):\n            if node.asname and node.asname.startswith(\"_\"):  # import math as __builtins__ swaps the builtins table\n                problems.append(f\"line {line}: {node.asname} starts with an underscore\")\n        elif isinstance(node, ast.Attribute):\n            if node.attr not in attrs:\n                problems.append(f\"line {line}: .{node.attr} is not on the allowed list\")\n            if not isinstance(node.ctx, ast.Load) and id(node) not in clears_grad:\n                problems.append(f\"line {line}: assigning to .{node.attr}\")\n        elif isinstance(node, ast.Name):\n            if node.id.startswith(\"_\") and node.id != \"_\":\n                problems.append(f\"line {line}: {node.id} starts with an underscore\")\n            elif node.id in forbidden:\n                problems.append(f\"line {line}: builtin {node.id} is not on the allowed list\")\n        elif isinstance(node, (ast.FunctionDef, ast.Lambda)):\n            if isinstance(node, ast.FunctionDef):\n                if node.name.startswith(\"_\"):\n                    problems.append(f\"line {line}: {node.name} starts with an underscore\")\n                if node.decorator_list:  # a decorator is a call at module level, so it could build state that persists\n                    problems.append(f\"line {line}: decorators are not allowed\")\n                if node.returns and not is_constant_expr(node.returns):\n                    problems.append(f\"line {line}: an annotation must be a constant\")\n            if not all(is_constant_expr(d) for d in [*node.args.defaults, *node.args.kw_defaults] if d is not None):\n                problems.append(f\"line {line}: a default argument must be a constant\")\n        elif isinstance(node, ast.arg) and node.annotation and not is_constant_expr(node.annotation):\n            problems.append(f\"line {line}: an annotation must be a constant\")  # annotations run once, at def time\n    for node in tree.body:\n        fine = isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef))\n        fine |= isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n        fine |= (isinstance(node, ast.Assign) and all(isinstance(t, ast.Name) for t in node.targets) and is_constant_expr(node.value))\n        if not fine:\n            problems.append(f\"line {node.lineno}: module level allows only imports, defs and constants\")\n    if literal_bytes(tree) > track[\"literal_cap\"]:\n        problems.append(f\"literals total {literal_bytes(tree)} bytes, over the cap of {track['literal_cap']}\")\n    if len(nodes) > track[\"node_cap\"]:\n        problems.append(f\"source has {len(nodes)} syntax nodes, over the cap of {track['node_cap']}\")\n    top = {n.name for n in tree.body if isinstance(n, ast.FunctionDef)}\n    problems += [f\"no top-level {f}()\" for f in (\"train\", \"forward\") if f not in top]\n    return problems\n\n\ndef load_entry(path, track):\n    \"\"\"Execute the entry with a builtins table that has no way out of the engine.\"\"\"\n    src = pathlib.Path(path).read_text(encoding=\"utf-8\")\n    problems = static_problems(src, track)\n    if problems:\n        raise SystemExit(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n\n    def guarded_import(name, globals=None, locals=None, fromlist=(), level=0):\n        if level or name not in ALLOWED_IMPORTS:\n            raise ImportError(f\"import of {name} is not allowed\")\n        return builtins.__import__(name, globals, locals, fromlist, level)\n\n    safe = {k: getattr(builtins, k) for k in ALLOWED_BUILTINS}\n    safe[\"__import__\"] = guarded_import\n    module = types.ModuleType(\"entry\")\n    module.__dict__[\"__builtins__\"] = safe\n    exec(compile(src, str(path), \"exec\"), module.__dict__)\n    return module\n\n\ndef peak_rss_mb():\n    import resource\n\n    kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n    return kb / 1024 ** (2 if sys.platform == \"darwin\" else 1)\n\n\ndef count_python_work(entry, cap, violation):\n    \"\"\"Deterministic fence on Python outside the engine: every line and jump of the entry costs one count.\"\"\"\n    mon, events = sys.monitoring, sys.monitoring.events\n    seen = [0]\n\n    def on_event(code, *rest):\n        if code.co_filename != entry:\n            return mon.DISABLE\n        seen[0] += 1\n        if seen[0] > cap:\n            raise violation(f\"more than {cap} Python lines and jumps in the entry\")\n\n    mon.use_tool_id(mon.PROFILER_ID, \"odometer\")\n    mon.register_callback(mon.PROFILER_ID, events.LINE, on_event)\n    mon.register_callback(mon.PROFILER_ID, events.JUMP, on_event)\n    mon.set_events(mon.PROFILER_ID, events.LINE | events.JUMP)\n    return seen\n\n\n# ---------------------------------------------------------------- the two child processes\n\n\ndef child_train(entry, seed, out):\n    import numpy as np\n\n    import odometer as od\n    from odometer import _data, _engine\n\n    out = pathlib.Path(out)\n    track = json.loads((out / \"track.json\").read_text())\n    _engine._M.reset(track[\"train_budget\"], seed, item_cap=track[\"item_cap\"])\n    data = _data.TrainData()\n    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n    t0 = time.perf_counter()\n    status, params = \"ok\", None\n    try:\n        params = load_entry(entry, track).train(data)\n    except od.BudgetExhausted as e:\n        status = f\"void: BudgetExhausted escaped train() ({e})\"\n    except od.RuleViolation as e:\n        status = f\"void: rule violation: {e}\"\n    seconds = time.perf_counter() - t0\n    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n    if status == \"ok\":\n        if not isinstance(params, dict) or not all(isinstance(k, str) and type(v) is od.Tensor for k, v in params.items()):\n            status = \"void: train() must return a dict of name -> Tensor\"\n        elif any(v.is_int for v in params.values()):\n            status = \"void: parameters must be float tensors\"\n        elif sum(v.size + len(k) for k, v in params.items()) > track[\"param_cap\"]:\n            status = f\"void: more than {track['param_cap']} parameters, with one more per character of their names\"\n        else:\n            np.savez(out / \"params.npz\", **{f\"p{i}\": v._d for i, v in enumerate(params.values())})\n            (out / \"names.json\").write_text(json.dumps(list(params)))\n    report = {\"status\": status, \"train_ticks\": _engine._M.used, \"train_seconds\": seconds, \"item_reads\": _engine._M.items,\n              \"train_python_lines\": lines[0], \"peak_rss_mb\": peak_rss_mb(), \"params\": sum(v.size for v in params.values()) if status == \"ok\" else None}\n    (out / \"train.json\").write_text(json.dumps(report))\n\n\ndef child_eval(entry, seed, split, out):\n    import numpy as np\n\n    import odometer as od\n    from odometer import _data, _engine\n\n    out = pathlib.Path(out)\n    track = json.loads((out / \"track.json\").read_text())\n    C, B = track[\"eval_context\"], track[\"eval_batch\"]\n    windows = _data.heldout_windows(split, C, track[\"eval_windows\"])\n    n = len(windows)\n    rng = np.random.default_rng([seed, 2])\n    twins = np.sort(rng.choice(n, int(n * track[\"twin_fraction\"]), replace=False))\n    cuts = rng.integers(1, C, size=twins.size)\n    donors = windows[rng.integers(0, n, size=twins.size)]\n    rows = np.concatenate([windows[:, :C], windows[twins, :C]])\n    probe = []\n    for j, (cut, donor) in enumerate(zip(cuts, donors)):\n        rows[n + j, cut:] = donor[cut:C]\n        last = np.arange(max(0, cut - 8), cut)  # a look-ahead leak shows first just before the cut\n        probe.append(np.union1d(last, rng.choice(cut, min(cut, track[\"twin_positions\"]), replace=False)))\n    probe_rows = {int(r): j for j, r in enumerate(twins)} | {n + j: j for j in range(twins.size)}\n    order = rng.permutation(len(rows))\n\n    scored_bytes = len(rows) * C\n    _engine._M.reset(track[\"eval_ticks_per_byte\"] * scored_bytes, seed, mode=\"eval\")\n    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n    t0 = time.perf_counter()\n    status = \"ok\"\n    nll = np.zeros(n)\n    seen = {}\n    try:\n        module = load_entry(entry, track)\n        names = json.loads((out / \"names.json\").read_text())\n        stored = np.load(out / \"params.npz\")\n        arrays = {name: stored[f\"p{i}\"] for i, name in enumerate(names)}\n        for a in arrays.values():\n            a.setflags(write=False)\n        for start in range(0, len(rows), B):\n            idx = order[start : start + B]\n            logits = module.forward({k: od.Tensor(a) for k, a in arrays.items()}, od.Tensor(rows[idx].astype(np.int32)))\n            if type(logits) is not od.Tensor or logits.is_int or logits.shape != (len(idx), C, od.VOCAB):\n                raise od.RuleViolation(f\"forward() must return float logits of shape (batch, {C}, {od.VOCAB})\")\n            z = logits._d.astype(np.float64)\n            if not np.isfinite(z).all():\n                raise od.RuleViolation(\"forward() returned non-finite logits\")\n            lp = z - z.max(-1, keepdims=True)\n            lp -= np.log(np.exp(lp).sum(-1, keepdims=True))\n            for b, r in enumerate(idx):\n                if r < n:\n                    nll[r] = -lp[b, np.arange(C), windows[r, 1:]].sum()\n                if int(r) in probe_rows:\n                    j = probe_rows[int(r)]\n                    seen.setdefault(j, []).append(lp[b, probe[j]])\n    except od.BudgetExhausted:\n        status = f\"void: forward() cost more than {track['eval_ticks_per_byte']:,} ticks per byte\"\n    except od.RuleViolation as e:\n        status = f\"void: rule violation: {e}\"\n    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n    twin_diff = max((float(np.abs(a - b).max()) for a, b in seen.values()), default=0.0) if status == \"ok\" else None\n    if status == \"ok\" and twin_diff > track[\"twin_tolerance\"]:\n        status = f\"void: twin check failed (logits before the cut moved by {twin_diff:.2e} nats)\"\n    report = {\"status\": status, \"split\": split, \"bpb\": float(nll.sum() / (n * C) / np.log(2)) if status == \"ok\" else None,\n              \"eval_ticks_per_byte\": _engine._M.used / scored_bytes, \"twin_max_diff\": twin_diff,\n              \"eval_python_lines\": lines[0], \"eval_seconds\": time.perf_counter() - t0}\n    (out / \"eval.json\").write_text(json.dumps(report))\n\n\n# ---------------------------------------------------------------- the parent\n\n\ndef run_seed(entry, seed, split, track, keep):\n    env = {\"PATH\": os.environ.get(\"PATH\", \"\"), **{v: \"1\" for v in THREAD_VARS}}\n    with tempfile.TemporaryDirectory() as tmp:\n        (pathlib.Path(tmp) / \"track.json\").write_text(json.dumps(track))\n        result = {\"seed\": seed}\n        for stage, extra in ((\"train\", []), (\"eval\", [split])):\n            cmd = [sys.executable, \"-I\", str(ROOT / \"verify.py\"), f\"--child-{stage}\", str(entry), str(seed), *extra, tmp]\n            log = keep / f\"seed-{seed}-{stage}.log\"\n            try:\n                with open(log, \"wb\") as sink:\n                    subprocess.run(cmd, cwd=tmp, env=env, stdout=sink, stderr=subprocess.STDOUT, timeout=track[\"wall_limit_seconds\"])\n            except subprocess.TimeoutExpired:\n                result[\"status\"] = f\"void: {stage} process passed the wall limit\"\n                return result\n            path = pathlib.Path(tmp) / f\"{stage}.json\"\n            if not path.exists():\n                result[\"status\"] = f\"void: {stage} process crashed (see {log.name})\"\n                return result\n            result |= json.loads(path.read_text())\n            if result[\"status\"] != \"ok\":\n                return result\n        return result\n\n\ndef machine():\n    import numpy as np\n\n    blas = np.show_config(mode=\"dicts\")[\"Build Dependencies\"][\"blas\"]\n    return {\"platform\": platform.platform(), \"machine\": platform.machine(), \"python\": platform.python_version(),\n            \"numpy\": np.__version__, \"blas\": f\"{blas.get('name')} {blas.get('version')}\", \"cpus\": os.cpu_count()}\n\n\ndef code_hash():\n    h = hashlib.sha256()\n    for p in [ROOT / \"verify.py\", *sorted((ROOT / \"odometer\").glob(\"*.py\"))]:\n        h.update(p.read_bytes())\n    return h.hexdigest()\n\n\ndef run_batch(entry, seeds, split, track, logs, jobs, label=\"\"):\n    with ThreadPoolExecutor(jobs) as pool:\n        results = []\n        for r in pool.map(lambda s: run_seed(entry, s, split, track, logs), seeds):\n            results.append(r)\n            if r[\"status\"] == \"ok\":\n                print(f\"  seed {r['seed']:>10}  {split} bpb {r['bpb']:.4f}  train {r['train_ticks']:.3e} ticks  \"\n                      f\"{r['train_seconds']:6.1f} s  eval {r['eval_ticks_per_byte']:,.0f} ticks/byte  \"\n                      f\"twins {r['twin_max_diff']:.1e}{label}\", flush=True)\n            else:\n                print(f\"  seed {r['seed']:>10}  {r['status']}{label}\", flush=True)\n    return results\n\n\ndef fresh_seeds(n):\n    return [secrets.randbits(31) for _ in range(n)]\n\n\ndef judge(bpbs, record_bpbs):\n    \"\"\"Does this batch beat the record by more than the margin? Welch, one-sided, on the verifier's own seeds.\"\"\"\n    w = stats.welch(bpbs, [b - RECORD_MARGIN for b in record_bpbs])\n    plain = stats.welch(bpbs, record_bpbs)\n    return {\"gain\": -plain[\"diff\"], \"ci95\": plain[\"ci95\"], \"df\": w[\"df\"], \"p_beyond_margin\": w[\"p_one_sided\"],\n            \"passes\": w[\"p_one_sided\"] < RECORD_ALPHA}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"entry\")\n    ap.add_argument(\"--seeds\", default=\"8\", help=\"a count of fresh seeds, or a comma list to rerun exact seeds ('11,' is seed 11)\")\n    ap.add_argument(\"--split\", default=\"test\", choices=(\"dev\", \"test\"))\n    ap.add_argument(\"--jobs\", type=int, default=0, help=\"seeds in parallel (default: min(seeds, cpus))\")\n    ap.add_argument(\"--against\", help=\"a record log; tests whether this entry beats it, then confirms on new seeds\")\n    ap.add_argument(\"--smoke\", action=\"store_true\", help=\"a tiny budget and a few windows; the number is not a score\")\n    ap.add_argument(\"--out\", help=\"where to write the log (default runs/<entry>-<time>.json)\")\n    args = ap.parse_args()\n\n    track = {**TRACK, **SMOKE} if args.smoke else TRACK\n    entry = pathlib.Path(args.entry).resolve()\n    src = entry.read_text(encoding=\"utf-8\")\n    problems = static_problems(src, track)\n    if problems:\n        print(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n        sys.exit(2)\n    seeds = [int(s) for s in args.seeds.split(\",\") if s] if \",\" in args.seeds else fresh_seeds(int(args.seeds))\n    name = entry.parent.name if entry.name == \"train.py\" else entry.stem\n    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\n    out = pathlib.Path(args.out) if args.out else ROOT / \"runs\" / f\"{name}-{stamp}.json\"\n    logs = out.with_suffix(\"\")\n    logs.mkdir(parents=True, exist_ok=True)\n    jobs = args.jobs or max(1, min(len(seeds), os.cpu_count() or 1))\n    print(f\"{name}: {len(seeds)} seeds on {args.split}, {jobs} at a time, budget {track['train_budget']:.1e} ticks\"\n          + (\" (smoke run: not a score)\" if args.smoke else \"\"), flush=True)\n\n    t0 = time.time()\n    results = run_batch(entry, seeds, args.split, track, logs, jobs)\n    ok = [r[\"bpb\"] for r in results if r[\"status\"] == \"ok\"]\n    log = {\"entry\": str(entry.relative_to(ROOT)) if entry.is_relative_to(ROOT) else entry.name,\n           \"sha256\": hashlib.sha256(src.encode()).hexdigest(), \"code_sha256\": code_hash(), \"track\": track,\n           \"split\": args.split, \"smoke\": args.smoke, \"machine\": machine(), \"started\": stamp, \"seeds\": results}\n    if len(ok) == len(results) and len(ok) >= 2:\n        m, half = stats.ci95(ok)\n        log[\"summary\"] = {\"mean_bpb\": m, \"ci95\": half, \"sd\": stats.mean_sd(ok)[1], \"n\": len(ok)}\n        print(f\"  mean {m:.4f} +- {half:.4f} bpb (95% CI, n={len(ok)}, sd {log['summary']['sd']:.4f})\")\n    elif len(ok) != len(results):\n        print(\"  void: at least one seed failed, so the entry has no score\")\n    elif ok:\n        print(f\"  {ok[0]:.4f} bpb on one seed (use at least 2 for an interval)\")\n\n    if args.against and \"summary\" in log:\n        inc = json.loads(pathlib.Path(args.against).read_text())\n        if inc[\"split\"] != args.split:\n            raise SystemExit(\"the record was scored on a different split\")\n        incumbent = [r[\"bpb\"] for r in inc.get(\"confirmation\", inc[\"seeds\"])]\n        stage1 = judge(ok, incumbent)\n        verdict = {\"against\": args.against, \"margin\": RECORD_MARGIN, \"alpha\": RECORD_ALPHA, \"stage1\": stage1, \"record\": False}\n        print(f\"  gain over the record: {stage1['gain']:+.4f} +- {stage1['ci95']:.4f} bpb, p = {stage1['p_beyond_margin']:.2g} \"\n              f\"(beyond a margin of {RECORD_MARGIN})\")\n        if stats.mean_sd(ok)[1] < LOW_VARIANCE_RATIO * stats.mean_sd(incumbent)[1]:\n            verdict[\"flag\"] = \"seed SD is far below the incumbent's; read the entry for a fixed init or data order\"\n            print(f\"  flag: {verdict['flag']}\")\n        if stage1[\"passes\"]:\n            print(\"  passed; confirming on new seeds\", flush=True)\n            second = run_batch(entry, fresh_seeds(len(seeds)), args.split, track, logs, jobs, label=\"  (confirmation)\")\n            log[\"confirmation\"] = second\n            good = [r[\"bpb\"] for r in second if r[\"status\"] == \"ok\"]\n            if len(good) == len(second):\n                stage2 = judge(good, incumbent)\n                verdict[\"stage2\"] = stage2\n                verdict[\"record\"] = stage2[\"passes\"]\n                print(f\"  confirmation: {stage2['gain']:+.4f} +- {stage2['ci95']:.4f} bpb, p = {stage2['p_beyond_margin']:.2g}\")\n        print(\"  NEW RECORD\" if verdict[\"record\"] else \"  not a record\")\n        log[\"verdict\"] = verdict\n    log[\"wall_seconds\"] = time.time() - t0\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(log, indent=1))\n    print(f\"  log: {out.relative_to(ROOT) if out.is_relative_to(ROOT) else out}\")\n    if len(ok) != len(results):\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    if len(sys.argv) > 1 and sys.argv[1] == \"--child-train\":\n        child_train(sys.argv[2], int(sys.argv[3]), sys.argv[4])\n    elif len(sys.argv) > 1 and sys.argv[1] == \"--child-eval\":\n        child_eval(sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5])\n    else:\n        main()\n", "numLines": 497, "startLine": 1, "totalLines": 497}}, "tool_result_meta": [{"id": "toolu_01PEgUU8xyXWwG7deygnWdNR", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "rule"}}]}
