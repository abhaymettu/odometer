engine.cpython-312.pyc\n\nruns:\ntotal 8\ndrwxr-xr-x  2 user user 4096 Nov  2 20:14 .\ndrwxr-xr-x 14 user user 4096 Nov  2 20:15 ..\n\ntools:\ntotal 20\ndrwxr-xr-x  2 user user  4096 Nov  2 20:14 .\ndrwxr-xr-x 14 user user  4096 Nov  2 20:15 ..\n-rw-r--r--  1 user user 10653 Nov  2 20:13 calibrate.py\n    293 entries/current/train.py\n    117 entries/gpt/train.py\n    120 entries/mixer/train.py\n    136 entries/modern/train.py\n    122 entries/ppm/train.py\n     83 entries/rnn/train.py\n     61 odometer/__init__.py\nwc: odometer/__pycache__: Is a directory\n      0 odometer/__pycache__\n     55 odometer/_data.py\n    866 odometer/_engine.py\n    233 tools/calibrate.py\n     93 stats.py\n    496 verify.py\n   2675 total\n\"\"\"The few statistics the track needs, with no dependency beyond the standard library.\"\"\"\n\nimport math\n\n\ndef mean_sd(xs):\n    n = len(xs)\n    m = sum(xs) / n\n    sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1)) if n > 1 else float(\"nan\")\n    return m, sd\n\n\ndef _betacf(a, b, x):\n    # continued fraction for the regularized incomplete beta function (Numerical Recipes, section 6.4)\n    qab, qap, qam = a + b, a + 1, a - 1\n    c, d = 1.0, 1 - qab * x / qap\n    d = 1 / (d if abs(d) > 1e-300 else 1e-300)\n    h = d\n    for m in range(1, 300):\n        m2 = 2 * m\n        for aa in (m * (b - m) * x / ((qam + m2) * (a + m2)), -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2))):\n            d = 1 + aa * d\n            d = 1 / (d if abs(d) > 1e-300 else 1e-300)\n            c = 1 + aa / c\n            c = c if abs(c) > 1e-300 else 1e-300\n            h *= d * c\n        if abs(d * c - 1) < 1e-14:\n            break\n    return h\n\n\ndef betainc(a, b, x):\n    if x <= 0:\n        return 0.0\n    if x >= 1:\n        return 1.0\n    lbeta = math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b)\n    front = math.exp(lbeta + a * math.log(x) + b * math.log(1 - x))\n    if x < (a + 1) / (a + b + 2):\n        return front * _betacf(a, b, x) / a\n    return 1 - front * _betacf(b, a, 1 - x) / b\n\n\ndef t_cdf(t, df):\n    tail = 0.5 * betainc(df / 2, 0.5, df / (df + t * t))\n    return 1 - tail if t >= 0 else tail\n\n\ndef t_ppf(p, df):\n    lo, hi = -1e3, 1e3\n    for _ in range(200):\n        mid = (lo + hi) / 2\n        lo, hi = (mid, hi) if t_cdf(mid, df) < p else (lo, mid)\n    return (lo + hi) / 2\n\n\ndef ci95(xs):\n    m, sd = mean_sd(xs)\n    half = t_ppf(0.975, len(xs) - 1) * sd / math.sqrt(len(xs))\n    return m, half\n\n\ndef welch(a, b):\n    \"\"\"Is mean(a) below mean(b)? Returns the difference, its 95% CI half-width, and the one-sided p.\"\"\"\n    ma, sa = mean_sd(a)\n    mb, sb = mean_sd(b)\n    va, vb = sa * sa / len(a), sb * sb / len(b)\n    se = math.sqrt(va + vb)\n    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n    diff = ma - mb\n    return {\"diff\": diff, \"ci95\": t_ppf(0.975, df) * se, \"p_one_sided\": t_cdf(diff / se, df), \"df\": df}\n\n\ndef tost(a, b, margin):\n    \"\"\"Two one-sided tests: are the means of a and b within +-margin of each other? Returns the larger p.\"\"\"\n    ma, sa = mean_sd(a)\n    mb, sb = mean_sd(b)\n    va, vb = sa * sa / len(a), sb * sb / len(b)\n    se = math.sqrt(va + vb)\n    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n    d = ma - mb\n    p_low = 1 - t_cdf((d + margin) / se, df)\n    p_high = t_cdf((d - margin) / se, df)\n    return {\"diff\": d, \"p\": max(p_low, p_high), \"ci90\": t_ppf(0.95, df) * se}\n\n\ndef wilson(k, n, z=1.959964):\n    if n == 0:\n        return float(\"nan\"), float(\"nan\")\n    p = k / n\n    centre = (p + z * z / (2 * n)) / (1 + z * z / n)\n    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)\n    return centre - half, centre + half\nPackage               Version\n--------------------- ---------------\nattrs                 23.2.0\nAutomat               22.10.0\nBabel                 2.10.3\nbcrypt                3.2.2\nblinker               1.7.0\nboto3                 1.34.46\nbotocore              1.34.46\ncertifi               2023.11.17\nchardet               5.2.0\nclick                 8.1.6\ncloud-init            25.3\ncolorama              0.4.6\ncommand-not-found     0.3\nconfigobj             5.0.8\nconstantly            23.10.4\ncryptography          41.0.7\ncupshelpers           1.0\ndbus-python           1.3.2\ndefer                 1.0.6\ndistro                1.9.0\ndistro-info           1.7+build1\nhttplib2              0.20.4\nhyperlink             21.0.0\nidna                  3.6\nincremental           22.10.0\nJinja2                3.1.2\njmespath              1.0.1\njsonpatch             1.32\n# Attacks\n\nEach file is an entry written to cheat. `tests/test_attacks.py` runs every one and pins the exact rejection. `legit_tiny` is the control and must pass.\n\n\"Hole\" means the attack got further than it should on the code before this suite. The fix is named beside it. Numbers are `--smoke` at seed 11 on an M-series Mac unless noted.\n\n## Reading what it should not\n\n- `peek_open`, `peek_numpy`, `peek_odometer_data`, `peek_import_tricks`, `peek_builtins_dunder`, `peek_reflection_builtins`: static rule on the name.\n- `peek_fullwidth_open`: fullwidth `open` folds to plain `open` in the parser, so the rule sees through it.\n- `peek_generator_frame`, `peek_no_grad_object`, `peek_format_walk`, `peek_fstring_attribute`, `peek_docstring`, `peek_match_pattern`: static rule on the attribute or the node.\n- `peek_shadow_then_use`: hole. Rebinding `open` as a local hid the name from the rule, and only a NameError in the child stopped it. Any use of a forbidden name now fails, in any scope.\n- `peek_builtins_alias`: hole. `import odometer as __builtins__` passed the rule and swapped the table free names resolve in. Import aliases now follow the underscore rule.\n- `peek_kwargs_expansion`, `peek_print_file`: past the rules, the child crashes and the run is void.\n- `peek_perc