e(v - m[k] * od.rsqrt(s[k] * c2 + 1e-16) * c1)\n            v.grad = None\n        worst = max(worst, od.used() - before)\n    print(\"gate steps\", step, \"ticks per pos\", (od.used() - start) / (step * GATE_BATCH * GATE_T))\n    return q\n\n\n'''+s[b:]\nopen('work/g2/train.py','w').write(s)\nE\npython - <<'E'\nimport sys; sys.path.insert(0,'.')\nimport verify\nprint(verify.static_problems(open('work/g2/train.py').read()))\nE\npython work/gb.py gate work/v5/train.py 11 work/g2/train.py; date; cat logs_w/e08.log logs_w/e13.log", "description": "Write scalar-path gate training and test on cached tables", "timeout": 120000}}}
