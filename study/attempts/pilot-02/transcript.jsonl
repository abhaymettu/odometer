{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_014Wh89aVzSs19AbhbJYZgLd", "type": "tool_result", "content": "1\t\"\"\"The few statistics the track needs, with no dependency beyond the standard library.\"\"\"\n2\t\n3\timport math\n4\t\n5\t\n6\tdef mean_sd(xs):\n7\t    n = len(xs)\n8\t    m = sum(xs) / n\n9\t    sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1)) if n > 1 else float(\"nan\")\n10\t    return m, sd\n11\t\n12\t\n13\tdef _betacf(a, b, x):\n14\t    # continued fraction for the regularized incomplete beta function (Numerical Recipes, section 6.4)\n15\t    qab, qap, qam = a + b, a + 1, a - 1\n16\t    c, d = 1.0, 1 - qab * x / qap\n17\t    d = 1 / (d if abs(d) > 1e-300 else 1e-300)\n18\t    h = d\n19\t    for m in range(1, 300):\n20\t        m2 = 2 * m\n21\t        for aa in (m * (b - m) * x / ((qam + m2) * (a + m2)), -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2))):\n22\t            d = 1 + aa * d\n23\t            d = 1 / (d if abs(d) > 1e-300 else 1e-300)\n24\t            c = 1 + aa / c\n25\t            c = c if abs(c) > 1e-300 else 1e-300\n26\t            h *= d * c\n27\t        if abs(d * c - 1) < 1e-14:\n28\t            break\n29\t    return h\n30\t\n31\t\n32\tdef betainc(a, b, x):\n33\t    if x <= 0:\n34\t        return 0.0\n35\t    if x >= 1:\n36\t        return 1.0\n37\t    lbeta = math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b)\n38\t    front = math.exp(lbeta + a * math.log(x) + b * math.log(1 - x))\n39\t    if x < (a + 1) / (a + b + 2):\n40\t        return front * _betacf(a, b, x) / a\n41\t    return 1 - front * _betacf(b, a, 1 - x) / b\n42\t\n43\t\n44\tdef t_cdf(t, df):\n45\t    tail = 0.5 * betainc(df / 2, 0.5, df / (df + t * t))\n46\t    return 1 - tail if t >= 0 else tail\n47\t\n48\t\n49\tdef t_ppf(p, df):\n50\t    lo, hi = -1e3, 1e3\n51\t    for _ in range(200):\n52\t        mid = (lo + hi) / 2\n53\t        lo, hi = (mid, hi) if t_cdf(mid, df) < p else (lo, mid)\n54\t    return (lo + hi) / 2\n55\t\n56\t\n57\tdef ci95(xs):\n58\t    m, sd = mean_sd(xs)\n59\t    half = t_ppf(0.975, len(xs) - 1) * sd / math.sqrt(len(xs))\n60\t    return m, half\n61\t\n62\t\n63\tdef welch(a, b):\n64\t    \"\"\"Is mean(a) below mean(b)? Returns the difference, its 95% CI half-width, and the one-sided p.\"\"\"\n65\t    ma, sa = mean_sd(a)\n66\t    mb, sb = mean_sd(b)\n67\t    va, vb = sa * sa / len(a), sb * sb / len(b)\n68\t    se = math.sqrt(va + vb)\n69\t    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n70\t    diff = ma - mb\n71\t    return {\"diff\": diff, \"ci95\": t_ppf(0.975, df) * se, \"p_one_sided\": t_cdf(diff / se, df), \"df\": df}\n72\t\n73\t\n74\tdef tost(a, b, margin):\n75\t    \"\"\"Two one-sided tests: are the means of a and b within +-margin of each other? Returns the larger p.\"\"\"\n76\t    ma, sa = mean_sd(a)\n77\t    mb, sb = mean_sd(b)\n78\t    va, vb = sa * sa / len(a), sb * sb / len(b)\n79\t    se = math.sqrt(va + vb)\n80\t    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n81\t    d = ma - mb\n82\t    p_low = 1 - t_cdf((d + margin) / se, df)\n83\t    p_high = t_cdf((d - margin) / se, df)\n84\t    return {\"diff\": d, \"p\": max(p_low, p_high), \"ci90\": t_ppf(0.95, df) * se}\n85\t\n86\t\n87\tdef wilson(k, n, z=1.959964):\n88\t    if n == 0:\n89\t        return float(\"nan\"), float(\"nan\")\n90\t    p = k / n\n91\t    centre = (p + z * z / (2 * n)) / (1 + z * z / n)\n92\t    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)\n93\t    return centre - half, centre + half\n94\t"}]}, "parent_tool_use_id": null, "session_id": "61298ef4-bd1a-4ea1-ab67-beb042061337", "uuid": "2f8c3515-08c2-4228-9ad8-077f0bcbe2aa", "timestamp": "2026-11-02T11:34:12.359Z", "tool_use_result": {"type": "text", "file": {"filePath": "/home/user/att/pilot-02/stats.py", "content": "\"\"\"The few statistics the track needs, with no dependency beyond the standard library.\"\"\"\n\nimport math\n\n\ndef mean_sd(xs):\n    n = len(xs)\n    m = sum(xs) / n\n    sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1)) if n > 1 else float(\"nan\")\n    return m, sd\n\n\ndef _betacf(a, b, x):\n    # continued fraction for the regularized incomplete beta function (Numerical Recipes, section 6.4)\n    qab, qap, qam = a + b, a + 1, a - 1\n    c, d = 1.0, 1 - qab * x / qap\n    d = 1 / (d if abs(d) > 1e-300 else 1e-300)\n    h = d\n    for m in range(1, 300):\n        m2 = 2 * m\n        for aa in (m * (b - m) * x / ((qam + m2) * (a + m2)), -(a + m) * (qab + m) * x / ((a + m2) * (qap + m2))):\n            d = 1 + aa * d\n            d = 1 / (d if abs(d) > 1e-300 else 1e-300)\n            c = 1 + aa / c\n            c = c if abs(c) > 1e-300 else 1e-300\n            h *= d * c\n        if abs(d * c - 1) < 1e-14:\n            break\n    return h\n\n\ndef betainc(a, b, x):\n    if x <= 0:\n        return 0.0\n    if x >= 1:\n        return 1.0\n    lbeta = math.lgamma(a + b) - math.lgamma(a) - math.lgamma(b)\n    front = math.exp(lbeta + a * math.log(x) + b * math.log(1 - x))\n    if x < (a + 1) / (a + b + 2):\n        return front * _betacf(a, b, x) / a\n    return 1 - front * _betacf(b, a, 1 - x) / b\n\n\ndef t_cdf(t, df):\n    tail = 0.5 * betainc(df / 2, 0.5, df / (df + t * t))\n    return 1 - tail if t >= 0 else tail\n\n\ndef t_ppf(p, df):\n    lo, hi = -1e3, 1e3\n    for _ in range(200):\n        mid = (lo + hi) / 2\n        lo, hi = (mid, hi) if t_cdf(mid, df) < p else (lo, mid)\n    return (lo + hi) / 2\n\n\ndef ci95(xs):\n    m, sd = mean_sd(xs)\n    half = t_ppf(0.975, len(xs) - 1) * sd / math.sqrt(len(xs))\n    return m, half\n\n\ndef welch(a, b):\n    \"\"\"Is mean(a) below mean(b)? Returns the difference, its 95% CI half-width, and the one-sided p.\"\"\"\n    ma, sa = mean_sd(a)\n    mb, sb = mean_sd(b)\n    va, vb = sa * sa / len(a), sb * sb / len(b)\n    se = math.sqrt(va + vb)\n    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n    diff = ma - mb\n    return {\"diff\": diff, \"ci95\": t_ppf(0.975, df) * se, \"p_one_sided\": t_cdf(diff / se, df), \"df\": df}\n\n\ndef tost(a, b, margin):\n    \"\"\"Two one-sided tests: are the means of a and b within +-margin of each other? Returns the larger p.\"\"\"\n    ma, sa = mean_sd(a)\n    mb, sb = mean_sd(b)\n    va, vb = sa * sa / len(a), sb * sb / len(b)\n    se = math.sqrt(va + vb)\n    df = (va + vb) ** 2 / (va * va / (len(a) - 1) + vb * vb / (len(b) - 1))\n    d = ma - mb\n    p_low = 1 - t_cdf((d + margin) / se, df)\n    p_high = t_cdf((d - margin) / se, df)\n    return {\"diff\": d, \"p\": max(p_low, p_high), \"ci90\": t_ppf(0.95, df) * se}\n\n\ndef wilson(k, n, z=1.959964):\n    if n == 0:\n        return float(\"nan\"), float(\"nan\")\n    p = k / n\n    centre = (p + z * z / (2 * n)) / (1 + z * z / n)\n    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + z * z / n)\n    return centre - half, centre + half\n", "numLines": 94, "startLine": 1, "totalLines": 94}}, "tool_result_meta": [{"id": "toolu_014Wh89aVzSs19AbhbJYZgLd", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "rule"}}]}
