{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01YVTbgtGsNhkKjsScVbheuF", "type": "tool_result", "content": "1\t\"\"\"Hashed context mixing in the PAQ tradition, trained by gradient descent.\n2\t\n3\tAfter Mahoney's PAQ and lpaq (mixing the predictions of many order-n contexts), with lstm-compress and cmix (Knoll) as\n4\tprior art for neural mixers; the tables are the hashing trick (Weinberger et al. 2009) as used for n-grams by fastText\n5\t(Joulin et al. 2017), and they train with AdaGrad (Duchi et al. 2011). Bengio et al. 2003 is the distant ancestor.\n6\t\n7\tEach order hashes its last n bytes with integer ops into its own table of EMBED-float rows. The rows are concatenated\n8\tand mixed by one squared-ReLU hidden layer into 256 logits. A table row never touched stays zero, so it adds nothing.\n9\t\n10\tWhy the price list favours this: embedding() costs 16 ticks per float backward whatever the table size, so a thin row\n11\tof 8 floats buys a lookup into a huge context for about 140 ticks. A hidden layer of 64 and a head add about 600, cross\n12\tentropy 768. That is about 2600 ticks per byte, against 20000 for the GPT here, so the mixer sees about eight times the\n13\tbytes. Tables take dense updates at about 2 ticks a float, so they update once per TABLE_EVERY batches.\n14\t\n15\tforward() is causal by construction: a position only hashes bytes at or before it. After the softmax it runs a PPM\n16\tbackoff (Cleary & Witten 1984; Teh 2006) over counts taken inside the 512-byte window itself. That gives the online\n17\tadaptivity a compressor has, such as a character's name from earlier in the story, for no training ticks at all.\n18\t\"\"\"\n19\t\n20\timport math\n21\t\n22\timport odometer as od\n23\t\n24\tORDERS = (1, 2, 3, 4, 5, 6, 8, 10, 12)\n25\tROWS = (256, 8191, 16381, 32749, 75989, 75989, 99991, 99991, 99991)  # 4.1 M floats in all; the cap is 4.19 M\n26\tEMBED = 8\n27\tHIDDEN = 64\n28\tBATCH = 64\n29\tWINDOW = 64\n30\tLR_TABLE = 0.25\n31\tLR_MIX = 6e-3\n32\tTABLE_EVERY = 4  # the tables update once per this many batches; their gradients add up in between\n33\tPAD = 24  # bytes of history before the first position trained on; at eval, zeros\n34\tLOCAL = ((2, 35.0, 0.6), (3, 6.0, 0.6), (5, 2.0, 0.6))  # eval stages: (index into ORDERS, concentration, discount)\n35\tWARMUP = 0.02\n36\tHASH_A = 16777619\n37\tHASH_B = 2654435761 % (1 << 31)\n38\t\n39\t\n40\tdef init_params():\n41\t    p = {f\"t{k}\": od.zeros((r, EMBED)) for k, r in enumerate(ROWS)}\n42\t    n = len(ORDERS) * EMBED\n43\t    p[\"up\"] = od.randn((n, HIDDEN), 1.0 / math.sqrt(n))\n44\t    p[\"bias\"] = od.ones((1, 1, HIDDEN))  # a row never trained is all zeros, so it adds nothing and the bias sets the prior\n45\t    p[\"head\"] = od.zeros((HIDDEN, 256))\n46\t    return {k: od.param(v) for k, v in p.items()}\n47\t\n48\t\n49\tdef order_rows(z):\n50\t    \"\"\"z holds PAD bytes of history, then the positions to predict. One tensor of table rows per order, (B, T).\"\"\"\n51\t    T = z.shape[1]\n52\t    h = z[:, PAD:] * 0\n53\t    out = []\n54\t    for n in range(1, max(ORDERS) + 1):\n55\t        h = h * HASH_A + z[:, PAD - n + 1 : T - n + 1]\n56\t        for i, order in enumerate(ORDERS):\n57\t            if order == n:\n58\t                out.append(h if n == 1 else (h * HASH_B + i) % ROWS[i])\n59\t    return out\n60\t\n61\t\n62\tdef mix(p, rows):\n63\t    parts = [od.embedding(p[f\"t{k}\"], r) for k, r in enumerate(rows)]\n64\t    a = od.relu(od.concat(parts, -1) @ p[\"up\"] + p[\"bias\"])\n65\t    return (a * a) @ p[\"head\"]\n66\t\n67\t\n68\tdef window_votes(rows, x):\n69\t    \"\"\"For each position and byte, how often this window already saw that byte follow this context. Causal: s < t.\"\"\"\n70\t    B, T = x.shape\n71\t    d = rows.reshape(B, T, 1) - rows.reshape(B, 1, T)\n72\t    same = od.tril((d >= 0) * (d <= 0), -1)\n73\t    eye = od.tril(od.ones((256, 256))) - od.tril(od.ones((256, 256)), -1)\n74\t    follows = od.embedding(eye, x[:, 1:])  # the byte after s, known once s < t\n75\t    return same[:, :, : T - 1] @ follows\n76\t\n77\t\n78\tdef forward(params, x):\n79\t    z = od.concat([x[:, :PAD] * 0, x], 1)\n80\t    rows = order_rows(z)\n81\t    out = mix(params, rows)\n82\t    p = od.softmax(out, -1)\n83\t    for i, beta, disc in LOCAL:\n84\t        c = window_votes(rows[i], x)\n85\t        total = od.sum(c, -1, keepdims=True)\n86\t        kinds = od.sum(c > 0.0, -1, keepdims=True)\n87\t        p = (od.relu(c - disc) + (kinds * disc + beta) * p) / (total + beta)\n88\t    return od.log(p + 1e-12)\n89\t\n90\t\n91\tdef train(data):\n92\t    p = init_params()\n93\t    tables = {k for k in p if k.startswith(\"t\")}\n94\t    m = {k: od.zeros(v.shape) for k, v in p.items() if k not in tables}\n95\t    s = {k: od.full(v.shape, 1e-8) for k, v in p.items()}\n96\t    start, span = od.used(), od.remaining()\n97\t    worst, step = 0, 0\n98\t    while od.remaining() > 2 * worst + 1_000_000:\n99\t        before = od.used()\n100\t        frac = (before - start) / span\n101\t        sched = frac / WARMUP if frac < WARMUP else 0.5 * (1 + math.cos(math.pi * (frac - WARMUP) / (1 - WARMUP)))\n102\t        z, y = data.batch(BATCH, WINDOW + PAD)\n103\t        od.cross_entropy(mix(p, order_rows(z)), y[:, PAD:]).backward()\n104\t        step += 1\n105\t        c1, c2 = LR_MIX * sched / (1 - 0.9**step), 1 / (1 - 0.99**step)\n106\t        lrt = LR_TABLE * min(1.0, frac / WARMUP)  # flat after warmup: AdaGrad already decays the tables\n107\t        for k, v in p.items():\n108\t            g = v.grad\n109\t            if k in tables:\n110\t                if step % TABLE_EVERY:\n111\t                    continue\n112\t                s[k] = s[k] + g * g\n113\t                v.update(v - g * od.rsqrt(s[k]) * lrt)\n114\t            else:\n115\t                m[k] = m[k] * 0.9 + g * 0.1\n116\t                s[k] = s[k] * 0.99 + g * g * 0.01\n117\t                v.update(v - m[k] * od.rsqrt(s[k] * c2