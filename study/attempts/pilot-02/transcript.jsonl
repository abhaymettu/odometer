{"type": "user", "message": {"role": "user", "content": [{"tool_use_id": "toolu_01Meen2iquTv6ceP3fn5q1oU", "type": "tool_result", "content": "1\t\"\"\"Rerun an entry on fresh seeds and score it. This file is the referee.\n2\t\n3\t    python verify.py entries/gpt/train.py                         # 8 fresh seeds, scored on the test split\n4\t    python verify.py entries/gpt/train.py --seeds 2               # 2 fresh seeds\n5\t    python verify.py entries/mine/train.py --seeds 11,12 --split dev\n6\t    python verify.py entries/mine/train.py --against records/current.json\n7\t    python verify.py entries/mine/train.py --smoke                # seconds, for checking that an entry runs\n8\t\n9\tWhat a run guarantees:\n10\t  1. The source passes static rules. It imports only odometer and math, and it can name only the engine's public API,\n11\t     math, and plain container methods. No try, class, global, match, decorator or attribute assignment (except\n12\t     x.grad = None), and no module-level state beyond constants. Literals and syntax nodes are rationed, so a table\n13\t     cannot be smuggled in the source.\n14\t  2. train() runs in its own process with one BLAS thread, under the training budget, with the verifier's seed. That\n15\t     process never loads held-out bytes. A run that lets BudgetExhausted escape is void.\n16\t  3. Python work outside the engine is counted, not timed: entry lines and jumps are capped. One C call counts once\n17\t     however long it runs (a sum over a long range, big-integer arithmetic); that work has only the rationed item()\n18\t     reads to learn from, and the wall limit ends it.\n19\t  4. Scoring runs in a second, fresh process. forward() sees held-out inputs, never targets, and its compute per byte\n20\t     is capped. Every call gets a fresh params dict and fresh tensors, so no state survives between calls. A quarter\n21\t     of the windows get a twin whose bytes after a random cut come from another window; a shuffle puts nearly all twins\n22\t     in other batches. Logits before the cut must match, which catches forward() looking ahead or across rows.\n23\t  5. Seeds are drawn fresh unless given, and written to the log, so anyone can rerun the exact runs.\n24\t\"\"\"\n25\t\n26\timport argparse\n27\timport ast\n28\timport builtins\n29\timport hashlib\n30\timport json\n31\timport math\n32\timport os\n33\timport pathlib\n34\timport platform\n35\timport secrets\n36\timport subprocess\n37\timport sys\n38\timport tempfile\n39\timport time\n40\timport types\n41\tfrom concurrent.futures import ThreadPoolExecutor\n42\t\n43\tROOT = pathlib.Path(__file__).resolve().parent\n44\tsys.path.insert(0, str(ROOT))\n45\t\n46\timport stats  # noqa: E402\n47\t\n48\tTRACK = {\n49\t    \"version\": \"odometer-v3\",\n50\t    \"train_budget\": 40_000_000_000,  # ticks for everything train() does; about 80 s on a 4-core VM, 25 s on an M4\n51\t    \"eval_ticks_per_byte\": 50_000,  # forward() price cap per scored byte\n52\t    \"param_cap\": 1 << 22,  # floats in the returned parameters, plus characters in their names\n53\t    \"source_cap\": 64 * 1024,  # bytes of train.py\n54\t    \"literal_cap\": 4096,  # bytes of literals, keyword names and function names in train.py\n55\t    \"node_cap\": 8192,  # syntax nodes in train.py; a table spelled in variable names has no literals to count\n56\t    \"python_lines\": 20_000_000,  # entry lines and jumps per process\n57\t    \"eval_context\": 512,\n58\t    \"eval_batch\": 16,\n59\t    \"eval_windows\": 1024,  # windows of eval_context bytes per held-out split\n60\t    \"twin_fraction\": 0.25,\n61\t    \"twin_positions\": 32,\n62\t    \"twin_tolerance\": 1e-4,  # max |log p| difference between twins, in nats; a leak this small gains 1.4e-4 bits per byte\n63\t    \"item_cap\": 20_000,  # item() reads in train()\n64\t    \"wall_limit_seconds\": 3600,  # only catches hangs; it never decides a score\n65\t}\n66\tSMOKE = {\"train_budget\": 2_000_000_000, \"eval_windows\": 32, \"wall_limit_seconds\": 300}\n67\tRECORD_ALPHA = 0.01\n68\tRECORD_MARGIN = 0.002  # bits per byte a new record must clear on top of the significance test\n69\tLOW_VARIANCE_RATIO = 0.3  # seed SD below this fraction of the incumbent's gets flagged for a human look\n70\tTHREAD_VARS = (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"VECLIB_MAXIMUM_THREADS\", \"NUMEXPR_NUM_THREADS\")\n71\t\n72\t# ---------------------------------------------------------------- static rules\n73\t\n74\tALLOWED_IMPORTS = {\"odometer\", \"math\"}\n75\tALLOWED_BUILTINS = {\n76\t    \"abs\", \"all\", \"any\", \"bool\", \"dict\", \"divmod\", \"enumerate\", \"float\", \"int\", \"isinstance\", \"len\", \"list\", \"max\",\n77\t    \"min\", \"pow\", \"print\", \"range\", \"reversed\", \"round\", \"set\", \"sorted\", \"str\", \"sum\", \"tuple\", \"zip\",\n78\t    \"True\", \"False\", \"None\",\n79\t}\n80\t# math without its functions over sequences and big integers, which do unbounded numeric work in one counted line\n81\tMATH_NAMES = {n for n in dir(math) if not n.startswith(\"_\")} - {\n82\t    \"comb\", \"dist\", \"factorial\", \"fsum\", \"gcd\", \"hypot\", \"isqrt\", \"lcm\", \"perm\", \"prod\", \"sumprod\",\n83\t}\n84\tCONTAINER_ATTRS = {\n85\t    \"append\", \"extend\", \"insert\", \"pop\", \"remove\", \"reverse\", \"sort\", \"index\", \"count\", \"clear\", \"copy\", \"items\", \"keys\",\n86\t    \"values\", \"get\", \"setdefault\", \"update\", \"join\", \"split\", \"strip\", \"startswith\", \"endswith\",\n87\t}\n88\tBANNED_NODES = (\n89\t    ast.ClassDef, ast.AsyncFunctionDef, ast.AsyncFor, ast.AsyncWith, ast.Await, ast.Try, ast.TryStar, ast.Match,\n90\t    ast.Global, ast.Nonlocal, ast.Delete, ast.TypeAlias,\n91\t)\n92\t\n93\t\n94\tdef allowed_attrs():\n95\t    import odometer as od\n96\t\n97\t    engine = {n for n in dir(od) if not n.startswith(\"_\")} - {\"Tensor\"}\n98\t    tensor = {n for n in dir(od.Tensor) if not n.startswith(\"_\")}\n99\t    return engine, engine | tensor | {\"batch\", \"num_bytes\"} | MATH_NAMES | CONTAINER_ATTRS\n100\t\n101\t\n102\tdef is_constant_expr(node):\n103\t    return all(isinstance(n, (ast.Constant, ast.Tuple, ast.UnaryOp, ast.BinOp, ast.Name, ast.Load, ast.operator, ast.unaryop))\n104\t               for n in ast.walk(node))\n105\t\n106\t\n107\tdef literal_bytes(tree):\n108\t    \"\"\"Everything in the source an entry can read back as data. dict(name=1) and str(function) turn names into strings.\"\"\"\n109\t    docstrings = {id(n.body[0].value) for n in ast.walk(tree)\n110\t                  if isinstance(n, (ast.Module, ast.FunctionDef)) and n.body and isinstance(n.body[0], ast.Expr)\n111\t                  and isinstance(n.body[0].value, ast.Constant) and isinstance(n.body[0].value.value, str)}\n112\t\n113\t    def size(v):\n114\t        if isinstance(v, str):\n115\t            return len(v.encode(\"utf-8\", \"surrogatepass\"))\n116\t        return len(v) if isinstance(v, bytes) else max(8, v.bit_length() // 8) if isinstance(v, int) else 8\n117\t\n118\t    total = 0\n119\t    for n in ast.walk(tree):\n120\t        if isinstance(n, ast.Constant) and id(n) not in docstrings:\n121\t            total += size(n.value)\n122\t        elif isinstance(n, ast.keyword) and n.arg:\n123\t            total += size(n.arg)\n124\t        elif isinstance(n, ast.FunctionDef):\n125\t            total += size(n.name)\n126\t    return total\n127\t\n128\t\n129\tdef static_problems(src, track=TRACK):\n130\t    if len(src.encode()) > track[\"source_cap\"]:\n131\t        return [f\"source is over {track['source_cap']} bytes\"]\n132\t    try:\n133\t        tree = ast.parse(src)\n134\t    except (SyntaxError, MemoryError, RecursionError) as e:\n135\t        return [f\"syntax error: {e}\"]\n136\t    engine, attrs = allowed_attrs()\n137\t    forbidden = set(dir(builtins)) - ALLOWED_BUILTINS\n138\t    nodes = list(ast.walk(tree))\n139\t    clears_grad = {id(t) for n in nodes if isinstance(n, ast.Assign) and isinstance(n.value, ast.Constant) and n.value.value is None\n140\t                   for t in n.targets if isinstance(t, ast.Attribute) and t.attr == \"grad\"}\n141\t    problems = []\n142\t    for node in nodes:\n143\t        line = getattr(node, \"lineno\", 0)\n144\t        if isinstance(node, BANNED_NODES):\n145\t            problems.append(f\"line {line}: {type(node).__name__} is not allowed\")\n146\t        elif isinstance(node, ast.Import):\n147\t            problems += [f\"line {line}: import {a.name}\" for a in node.names if a.name not in ALLOWED_IMPORTS]\n148\t        elif isinstance(node, ast.ImportFrom):\n149\t            if node.level or node.module not in ALLOWED_IMPORTS:\n150\t                problems.append(f\"line {line}: from {'.' * node.level}{node.module or ''} import\")\n151\t            else:\n152\t                names = engine if node.module == \"odometer\" else MATH_NAMES\n153\t                problems += [f\"line {line}: from {node.module} import {a.name}\" for a in node.names if a.name not in names]\n154\t        elif isinstance(node, ast.alias):\n155\t            if node.asname and node.asname.startswith(\"_\"):  # import math as __builtins__ swaps the builtins table\n156\t                problems.append(f\"line {line}: {node.asname} starts with an underscore\")\n157\t        elif isinstance(node, ast.Attribute):\n158\t            if node.attr not in attrs:\n159\t                problems.append(f\"line {line}: .{node.attr} is not on the allowed list\")\n160\t            if not isinstance(node.ctx, ast.Load) and id(node) not in clears_grad:\n161\t                problems.append(f\"line {line}: assigning to .{node.attr}\")\n162\t        elif isinstance(node, ast.Name):\n163\t            if node.id.startswith(\"_\") and node.id != \"_\":\n164\t                problems.append(f\"line {line}: {node.id} starts with an underscore\")\n165\t            elif node.id in forbidden:\n166\t                problems.append(f\"line {line}: builtin {node.id} is not on the allowed list\")\n167\t        elif isinstance(node, (ast.FunctionDef, ast.Lambda)):\n168\t            if isinstance(node, ast.FunctionDef):\n169\t                if node.name.startswith(\"_\"):\n170\t                    problems.append(f\"line {line}: {node.name} starts with an underscore\")\n171\t                if node.decorator_list:  # a decorator is a call at module level, so it could build state that persists\n172\t                    problems.append(f\"line {line}: decorators are not allowed\")\n173\t                if node.returns and not is_constant_expr(node.returns):\n174\t                    problems.append(f\"line {line}: an annotation must be a constant\")\n175\t            if not all(is_constant_expr(d) for d in [*node.args.defaults, *node.args.kw_defaults] if d is not None):\n176\t                problems.append(f\"line {line}: a default argument must be a constant\")\n177\t        elif isinstance(node, ast.arg) and node.annotation and not is_constant_expr(node.annotation):\n178\t            problems.append(f\"line {line}: an annotation must be a constant\")  # annotations run once, at def time\n179\t    for node in tree.body:\n180\t        fine = isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef))\n181\t        fine |= isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n182\t        fine |= (isinstance(node, ast.Assign) and all(isinstance(t, ast.Name) for t in node.targets) and is_constant_expr(node.value))\n183\t        if not fine:\n184\t            problems.append(f\"line {node.lineno}: module level allows only imports, defs and constants\")\n185\t    if literal_bytes(tree) > track[\"literal_cap\"]:\n186\t        problems.append(f\"literals total {literal_bytes(tree)} bytes, over the cap of {track['literal_cap']}\")\n187\t    if len(nodes) > track[\"node_cap\"]:\n188\t        problems.append(f\"source has {len(nodes)} syntax nodes, over the cap of {track['node_cap']}\")\n189\t    top = {n.name for n in tree.body if isinstance(n, ast.FunctionDef)}\n190\t    problems += [f\"no top-level {f}()\" for f in (\"train\", \"forward\") if f not in top]\n191\t    return problems\n192\t\n193\t\n194\tdef load_entry(path, track):\n195\t    \"\"\"Execute the entry with a builtins table that has no way out of the engine.\"\"\"\n196\t    src = pathlib.Path(path).read_text(encoding=\"utf-8\")\n197\t    problems = static_problems(src, track)\n198\t    if problems:\n199\t        raise SystemExit(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n200\t\n201\t    def guarded_import(name, globals=None, locals=None, fromlist=(), level=0):\n202\t        if level or name not in ALLOWED_IMPORTS:\n203\t            raise ImportError(f\"import of {name} is not allowed\")\n204\t        return builtins.__import__(name, globals, locals, fromlist, level)\n205\t\n206\t    safe = {k: getattr(builtins, k) for k in ALLOWED_BUILTINS}\n207\t    safe[\"__import__\"] = guarded_import\n208\t    module = types.ModuleType(\"entry\")\n209\t    module.__dict__[\"__builtins__\"] = safe\n210\t    exec(compile(src, str(path), \"exec\"), module.__dict__)\n211\t    return module\n212\t\n213\t\n214\tdef peak_rss_mb():\n215\t    try:\n216\t        import resource\n217\t    except ImportError:  # Windows\n218\t        return None\n219\t    kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n220\t    return kb / 1024 ** (2 if sys.platform == \"darwin\" else 1)\n221\t\n222\t\n223\tdef count_python_work(entry, cap, violation):\n224\t    \"\"\"Deterministic fence on Python outside the engine: every line and jump of the entry costs one count.\"\"\"\n225\t    mon, events = sys.monitoring, sys.monitoring.events\n226\t    seen = [0]\n227\t\n228\t    def on_event(code, *rest):\n229\t        if code.co_filename != entry:\n230\t            return mon.DISABLE\n231\t        seen[0] += 1\n232\t        if seen[0] > cap:\n233\t            raise violation(f\"more than {cap} Python lines and jumps in the entry\")\n234\t\n235\t    mon.use_tool_id(mon.PROFILER_ID, \"odometer\")\n236\t    mon.register_callback(mon.PROFILER_ID, events.LINE, on_event)\n237\t    mon.register_callback(mon.PROFILER_ID, events.JUMP, on_event)\n238\t    mon.set_events(mon.PROFILER_ID, events.LINE | events.JUMP)\n239\t    return seen\n240\t\n241\t\n242\t# ---------------------------------------------------------------- the two child processes\n243\t\n244\t\n245\tdef child_train(entry, seed, out):\n246\t    import numpy as np\n247\t\n248\t    import odometer as od\n249\t    from odometer import _data, _engine\n250\t\n251\t    out = pathlib.Path(out)\n252\t    track = json.loads((out / \"track.json\").read_text())\n253\t    _engine._M.reset(track[\"train_budget\"], seed, item_cap=track[\"item_cap\"])\n254\t    data = _data.TrainData()\n255\t    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n256\t    t0 = time.perf_counter()\n257\t    status, params = \"ok\", None\n258\t    try:\n259\t        params = load_entry(entry, track).train(data)\n260\t    except od.BudgetExhausted as e:\n261\t        status = f\"void: BudgetExhausted escaped train() ({e})\"\n262\t    except od.RuleViolation as e:\n263\t        status = f\"void: rule violation: {e}\"\n264\t    seconds = time.perf_counter() - t0\n265\t    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n266\t    if status == \"ok\":\n267\t        if not isinstance(params, dict) or not all(isinstance(k, str) and type(v) is od.Tensor for k, v in params.items()):\n268\t            status = \"void: train() must return a dict of name -> Tensor\"\n269\t        elif any(v.is_int for v in params.values()):\n270\t            status = \"void: parameters must be float tensors\"\n271\t        elif sum(v.size + len(k) for k, v in params.items()) > track[\"param_cap\"]:\n272\t            status = f\"void: more than {track['param_cap']} parameters, with one more per character of their names\"\n273\t        else:\n274\t            np.savez(out / \"params.npz\", **{f\"p{i}\": v._d for i, v in enumerate(params.values())})\n275\t            (out / \"names.json\").write_text(json.dumps(list(params)))\n276\t    report = {\"status\": status, \"train_ticks\": _engine._M.used, \"train_seconds\": seconds, \"item_reads\": _engine._M.items,\n277\t              \"train_python_lines\": lines[0], \"peak_rss_mb\": peak_rss_mb(), \"params\": sum(v.size for v in params.values()) if status == \"ok\" else None}\n278\t    (out / \"train.json\").write_text(json.dumps(report))\n279\t\n280\t\n281\tdef child_eval(entry, seed, split, out):\n282\t    import numpy as np\n283\t\n284\t    import odometer as od\n285\t    from odometer import _data, _engine\n286\t\n287\t    out = pathlib.Path(out)\n288\t    track = json.loads((out / \"track.json\").read_text())\n289\t    C, B = track[\"eval_context\"], track[\"eval_batch\"]\n290\t    windows = _data.heldout_windows(split, C, track[\"eval_windows\"])\n291\t    n = len(windows)\n292\t    rng = np.random.default_rng([seed, 2])\n293\t    twins = np.sort(rng.choice(n, int(n * track[\"twin_fraction\"]), replace=False))\n294\t    cuts = rng.integers(1, C, size=twins.size)\n295\t    donors = windows[rng.integers(0, n, size=twins.size)]\n296\t    rows = np.concatenate([windows[:, :C], windows[twins, :C]])\n297\t    probe = []\n298\t    for j, (cut, donor) in enumerate(zip(cuts, donors)):\n299\t        rows[n + j, cut:] = donor[cut:C]\n300\t        last = np.arange(max(0, cut - 8), cut)  # a look-ahead leak shows first just before the cut\n301\t        probe.append(np.union1d(last, rng.choice(cut, min(cut, track[\"twin_positions\"]), replace=False)))\n302\t    probe_rows = {int(r): j for j, r in enumerate(twins)} | {n + j: j for j in range(twins.size)}\n303\t    order = rng.permutation(len(rows))\n304\t\n305\t    scored_bytes = len(rows) * C\n306\t    _engine._M.reset(track[\"eval_ticks_per_byte\"] * scored_bytes, seed, mode=\"eval\")\n307\t    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n308\t    t0 = time.perf_counter()\n309\t    status = \"ok\"\n310\t    nll = np.zeros(n)\n311\t    seen = {}\n312\t    try:\n313\t        module = load_entry(entry, track)\n314\t        names = json.loads((out / \"names.json\").read_text())\n315\t        stored = np.load(out / \"params.npz\")\n316\t        arrays = {name: stored[f\"p{i}\"] for i, name in enumerate(names)}\n317\t        for a in arrays.values():\n318\t            a.setflags(write=False)\n319\t        for start in range(0, len(rows), B):\n320\t            idx = order[start : start + B]\n321\t            logits = module.forward({k: od.Tensor(a) for k, a in arrays.items()}, od.Tensor(rows[idx].astype(np.int32)))\n322\t            if type(logits) is not od.Tensor or logits.is_int or logits.shape != (len(idx), C, od.VOCAB):\n323\t                raise od.RuleViolation(f\"forward() must return float logits of shape (batch, {C}, {od.VOCAB})\")\n324\t            z = logits._d.astype(np.float64)\n325\t            if not np.isfinite(z).all():\n326\t                raise od.RuleViolation(\"forward() returned non-finite logits\")\n327\t            lp = z - z.max(-1, keepdims=True)\n328\t            lp -= np.log(np.exp(lp).sum(-1, keepdims=True))\n329\t            for b, r in enumerate(idx):\n330\t                if r < n:\n331\t                    nll[r] = -lp[b, np.arange(C), windows[r, 1:]].sum()\n332\t                if int(r) in probe_rows:\n333\t                    j = probe_rows[int(r)]\n334\t                    seen.setdefault(j, []).append(lp[b, probe[j]])\n335\t    except od.BudgetExhausted:\n336\t        status = f\"void: forward() cost more than {track['eval_ticks_per_byte']:,} ticks per byte\"\n337\t    except od.RuleViolation as e:\n338\t        status = f\"void: rule violation: {e}\"\n339\t    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n340\t    twin_diff = max((float(np.abs(a - b).max()) for a, b in seen.values()), default=0.0) if status == \"ok\" else None\n341\t    if status == \"ok\" and twin_diff > track[\"twin_tolerance\"]:\n342\t        status = f\"void: twin check failed (logits before the cut moved by {twin_diff:.2e} nats)\"\n343\t    report = {\"status\": status, \"split\": split, \"bpb\": float(nll.sum() / (n * C) / np.log(2)) if status == \"ok\" else None,\n344\t              \"eval_ticks_per_byte\": _engine._M.used / scored_bytes, \"twin_max_diff\": twin_diff,\n345\t              \"eval_python_lines\": lines[0], \"eval_seconds\": time.perf_counter() - t0}\n346\t    (out / \"eval.json\").write_text(json.dumps(report))\n347\t\n348\t\n349\t# ---------------------------------------------------------------- the parent\n350\t\n351\t\n352\tdef run_seed(entry, seed, split, track, keep):\n353\t    env = {\"PATH\": os.environ.get(\"PATH\", \"\"), **{v: \"1\" for v in THREAD_VARS}}\n354\t    with tempfile.TemporaryDirectory() as tmp:\n355\t        (pathlib.Path(tmp) / \"track.json\").write_text(json.dumps(track))\n356\t        result = {\"seed\": seed}\n357\t        for stage, extra in ((\"train\", []), (\"eval\", [split])):\n358\t            cmd = [sys.executable, \"-I\", str(ROOT / \"verify.py\"), f\"--child-{stage}\", str(entry), str(seed), *extra, tmp]\n359\t            log = keep / f\"seed-{seed}-{stage}.log\"\n360\t            try:\n361\t                with open(log, \"wb\") as sink:\n362\t                    subprocess.run(cmd, cwd=tmp, env=env, stdout=sink, stderr=subprocess.STDOUT, timeout=track[\"wall_limit_seconds\"])\n363\t            except subprocess.TimeoutExpired:\n364\t                result[\"status\"] = f\"void: {stage} process passed the wall limit\"\n365\t                return result\n366\t            path = pathlib.Path(tmp) / f\"{stage}.json\"\n367\t            if not path.exists():\n368\t                result[\"status\"] = f\"void: {stage} process crashed (see {log.name})\"\n369\t                return result\n370\t            result |= json.loads(path.read_text())\n371\t            if result[\"status\"] != \"ok\":\n372\t                return result\n373\t        return result\n374\t\n375\t\n376\tdef machine():\n377\t    import numpy as np\n378\t\n379\t    blas = np.show_config(mode=\"dicts\")[\"Build Dependencies\"][\"blas\"]\n380\t    return {\"platform\": platform.platform(), \"machine\": platform.machine(), \"python\": platform.python_version(),\n381\t            \"numpy\": np.__version__, \"blas\": f\"{blas.get('name')} {blas.get('version')}\", \"cpus\": os.cpu_count()}\n382\t\n383\t\n384\tdef code_hash():\n385\t    h = hashlib.sha256()\n386\t    for p in [ROOT / \"verify.py\", *sorted((ROOT / \"odometer\").glob(\"*.py\"))]:\n387\t        h.update(p.read_bytes())\n388\t    return h.hexdigest()\n389\t\n390\t\n391\tdef run_batch(entry, seeds, split, track, logs, jobs, label=\"\"):\n392\t    with ThreadPoolExecutor(jobs) as pool:\n393\t        results = []\n394\t        for r in pool.map(lambda s: run_seed(entry, s, split, track, logs), seeds):\n395\t            results.append(r)\n396\t            if r[\"status\"] == \"ok\":\n397\t                print(f\"  seed {r['seed']:>10}  {split} bpb {r['bpb']:.4f}  train {r['train_ticks']:.3e} ticks  \"\n398\t                      f\"{r['train_seconds']:6.1f} s  eval {r['eval_ticks_per_byte']:,.0f} ticks/byte  \"\n399\t                      f\"twins {r['twin_max_diff']:.1e}{label}\", flush=True)\n400\t            else:\n401\t                print(f\"  seed {r['seed']:>10}  {r['status']}{label}\", flush=True)\n402\t    return results\n403\t\n404\t\n405\tdef fresh_seeds(n):\n406\t    return [secrets.randbits(31) for _ in range(n)]\n407\t\n408\t\n409\tdef judge(bpbs, record_bpbs):\n410\t    \"\"\"Does this batch beat the record by more than the margin? Welch, one-sided, on the verifier's own seeds.\"\"\"\n411\t    w = stats.welch(bpbs, [b - RECORD_MARGIN for b in record_bpbs])\n412\t    plain = stats.welch(bpbs, record_bpbs)\n413\t    return {\"gain\": -plain[\"diff\"], \"ci95\": plain[\"ci95\"], \"df\": w[\"df\"], \"p_beyond_margin\": w[\"p_one_sided\"],\n414\t            \"passes\": w[\"p_one_sided\"] < RECORD_ALPHA}\n415\t\n416\t\n417\tdef main():\n418\t    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n419\t    ap.add_argument(\"entry\")\n420\t    ap.add_argument(\"--seeds\", default=\"8\", help=\"a count of fresh seeds, or a comma list to rerun exact seeds ('11,' is seed 11)\")\n421\t    ap.add_argument(\"--split\", default=\"test\", choices=(\"dev\", \"test\"))\n422\t    ap.add_argument(\"--jobs\", type=int, default=0, help=\"seeds in parallel (default: min(seeds, cpus))\")\n423\t    ap.add_argument(\"--against\", help=\"a record log; tests whether this entry beats it, then confirms on new seeds\")\n424\t    ap.add_argument(\"--smoke\", action=\"store_true\", help=\"a tiny budget and a few windows; the number is not a score\")\n425\t    ap.add_argument(\"--out\", help=\"where to write the log (default runs/<entry>-<time>.json)\")\n426\t    args = ap.parse_args()\n427\t\n428\t    track = {**TRACK, **SMOKE} if args.smoke else TRACK\n429\t    entry = pathlib.Path(args.entry).resolve()\n430\t    src = entry.read_text(encoding=\"utf-8\")\n431\t    problems = static_problems(src, track)\n432\t    if problems:\n433\t        print(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n434\t        sys.exit(2)\n435\t    seeds = [int(s) for s in args.seeds.split(\",\") if s] if \",\" in args.seeds else fresh_seeds(int(args.seeds))\n436\t    name = entry.parent.name if entry.name == \"train.py\" else entry.stem\n437\t    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\n438\t    out = pathlib.Path(args.out) if args.out else ROOT / \"runs\" / f\"{name}-{stamp}.json\"\n439\t    logs = out.with_suffix(\"\")\n440\t    logs.mkdir(parents=True, exist_ok=True)\n441\t    jobs = args.jobs or max(1, min(len(seeds), os.cpu_count() or 1))\n442\t    print(f\"{name}: {len(seeds)} seeds on {args.split}, {jobs} at a time, budget {track['train_budget']:.1e} ticks\"\n443\t          + (\" (smoke run: not a score)\" if args.smoke else \"\"), flush=True)\n444\t\n445\t    t0 = time.time()\n446\t    results = run_batch(entry, seeds, args.split, track, logs, jobs)\n447\t    ok = [r[\"bpb\"] for r in results if r[\"status\"] == \"ok\"]\n448\t    log = {\"entry\": str(entry.relative_to(ROOT)) if entry.is_relative_to(ROOT) else entry.name,\n449\t           \"sha256\": hashlib.sha256(src.encode()).hexdigest(), \"code_sha256\": code_hash(), \"track\": track,\n450\t           \"split\": args.split, \"smoke\": args.smoke, \"machine\": machine(), \"started\": stamp, \"seeds\": results}\n451\t    if len(ok) == len(results) and len(ok) >= 2:\n452\t        m, half = stats.ci95(ok)\n453\t        log[\"summary\"] = {\"mean_bpb\": m, \"ci95\": half, \"sd\": stats.mean_sd(ok)[1], \"n\": len(ok)}\n454\t        print(f\"  mean {m:.4f} +- {half:.4f} bpb (95% CI, n={len(ok)}, sd {log['summary']['sd']:.4f})\")\n455\t    elif len(ok) != len(results):\n456\t        print(\"  void: at least one seed failed, so the entry has no score\")\n457\t    elif ok:\n458\t        print(f\"  {ok[0]:.4f} bpb on one seed (use at least 2 for an interval)\")\n459\t\n460\t    if args.against and \"summary\" in log:\n461\t        inc = json.loads(pathlib.Path(args.against).read_text())\n462\t        if inc[\"split\"] != args.split:\n463\t            raise SystemExit(\"the record was scored on a different split\")\n464\t        incumbent = [r[\"bpb\"] for r in inc.get(\"confirmation\", inc[\"seeds\"])]\n465\t        stage1 = judge(ok, incumbent)\n466\t        verdict = {\"against\": args.against, \"margin\": RECORD_MARGIN, \"alpha\": RECORD_ALPHA, \"stage1\": stage1, \"record\": False}\n467\t        print(f\"  gain over the record: {stage1['gain']:+.4f} +- {stage1['ci95']:.4f} bpb, p = {stage1['p_beyond_margin']:.2g} \"\n468\t              f\"(beyond a margin of {RECORD_MARGIN})\")\n469\t        if stats.mean_sd(ok)[1] < LOW_VARIANCE_RATIO * stats.mean_sd(incumbent)[1]:\n470\t            verdict[\"flag\"] = \"seed SD is far below the incumbent's; read the entry for a fixed init or data order\"\n471\t            print(f\"  flag: {verdict['flag']}\")\n472\t        if stage1[\"passes\"]:\n473\t            print(\"  passed; confirming on new seeds\", flush=True)\n474\t            second = run_batch(entry, fresh_seeds(len(seeds)), args.split, track, logs, jobs, label=\"  (confirmation)\")\n475\t            log[\"confirmation\"] = second\n476\t            good = [r[\"bpb\"] for r in second if r[\"status\"] == \"ok\"]\n477\t            if len(good) == len(second):\n478\t                stage2 = judge(good, incumbent)\n479\t                verdict[\"stage2\"] = stage2\n480\t                verdict[\"record\"] = stage2[\"passes\"]\n481\t                print(f\"  confirmation: {stage2['gain']:+.4f} +- {stage2['ci95']:.4f} bpb, p = {stage2['p_beyond_margin']:.2g}\")\n482\t        print(\"  NEW RECORD\" if verdict[\"record\"] else \"  not a record\")\n483\t        log[\"verdict\"] = verdict\n484\t    log[\"wall_seconds\"] = time.time() - t0\n485\t    out.parent.mkdir(parents=True, exist_ok=True)\n486\t    out.write_text(json.dumps(log, indent=1))\n487\t    print(f\"  log: {out.relative_to(ROOT) if out.is_relative_to(ROOT) else out}\")\n488\t    if len(ok) != len(results):\n489\t        sys.exit(1)\n490\t\n491\t\n492\tif __name__ == \"__main__\":\n493\t    if len(sys.argv) > 1 and sys.argv[1] == \"--child-train\":\n494\t        child_train(sys.argv[2], int(sys.argv[3]), sys.argv[4])\n495\t    elif len(sys.argv) > 1 and sys.argv[1] == \"--child-eval\":\n496\t        child_eval(sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5])\n497\t    else:\n498\t        main()\n499\t"}]}, "parent_tool_use_id": null, "session_id": "61298ef4-bd1a-4ea1-ab67-beb042061337", "uuid": "5fd52098-4ab3-47c5-9f59-30322743890a", "timestamp": "2026-11-02T11:34:12.025Z", "tool_use_result": {"type": "text", "file": {"filePath": "/home/user/att/pilot-02/verify.py", "content": "\"\"\"Rerun an entry on fresh seeds and score it. This file is the referee.\n\n    python verify.py entries/gpt/train.py                         # 8 fresh seeds, scored on the test split\n    python verify.py entries/gpt/train.py --seeds 2               # 2 fresh seeds\n    python verify.py entries/mine/train.py --seeds 11,12 --split dev\n    python verify.py entries/mine/train.py --against records/current.json\n    python verify.py entries/mine/train.py --smoke                # seconds, for checking that an entry runs\n\nWhat a run guarantees:\n  1. The source passes static rules. It imports only odometer and math, and it can name only the engine's public API,\n     math, and plain container methods. No try, class, global, match, decorator or attribute assignment (except\n     x.grad = None), and no module-level state beyond constants. Literals and syntax nodes are rationed, so a table\n     cannot be smuggled in the source.\n  2. train() runs in its own process with one BLAS thread, under the training budget, with the verifier's seed. That\n     process never loads held-out bytes. A run that lets BudgetExhausted escape is void.\n  3. Python work outside the engine is counted, not timed: entry lines and jumps are capped. One C call counts once\n     however long it runs (a sum over a long range, big-integer arithmetic); that work has only the rationed item()\n     reads to learn from, and the wall limit ends it.\n  4. Scoring runs in a second, fresh process. forward() sees held-out inputs, never targets, and its compute per byte\n     is capped. Every call gets a fresh params dict and fresh tensors, so no state survives between calls. A quarter\n     of the windows get a twin whose bytes after a random cut come from another window; a shuffle puts nearly all twins\n     in other batches. Logits before the cut must match, which catches forward() looking ahead or across rows.\n  5. Seeds are drawn fresh unless given, and written to the log, so anyone can rerun the exact runs.\n\"\"\"\n\nimport argparse\nimport ast\nimport builtins\nimport hashlib\nimport json\nimport math\nimport os\nimport pathlib\nimport platform\nimport secrets\nimport subprocess\nimport sys\nimport tempfile\nimport time\nimport types\nfrom concurrent.futures import ThreadPoolExecutor\n\nROOT = pathlib.Path(__file__).resolve().parent\nsys.path.insert(0, str(ROOT))\n\nimport stats  # noqa: E402\n\nTRACK = {\n    \"version\": \"odometer-v3\",\n    \"train_budget\": 40_000_000_000,  # ticks for everything train() does; about 80 s on a 4-core VM, 25 s on an M4\n    \"eval_ticks_per_byte\": 50_000,  # forward() price cap per scored byte\n    \"param_cap\": 1 << 22,  # floats in the returned parameters, plus characters in their names\n    \"source_cap\": 64 * 1024,  # bytes of train.py\n    \"literal_cap\": 4096,  # bytes of literals, keyword names and function names in train.py\n    \"node_cap\": 8192,  # syntax nodes in train.py; a table spelled in variable names has no literals to count\n    \"python_lines\": 20_000_000,  # entry lines and jumps per process\n    \"eval_context\": 512,\n    \"eval_batch\": 16,\n    \"eval_windows\": 1024,  # windows of eval_context bytes per held-out split\n    \"twin_fraction\": 0.25,\n    \"twin_positions\": 32,\n    \"twin_tolerance\": 1e-4,  # max |log p| difference between twins, in nats; a leak this small gains 1.4e-4 bits per byte\n    \"item_cap\": 20_000,  # item() reads in train()\n    \"wall_limit_seconds\": 3600,  # only catches hangs; it never decides a score\n}\nSMOKE = {\"train_budget\": 2_000_000_000, \"eval_windows\": 32, \"wall_limit_seconds\": 300}\nRECORD_ALPHA = 0.01\nRECORD_MARGIN = 0.002  # bits per byte a new record must clear on top of the significance test\nLOW_VARIANCE_RATIO = 0.3  # seed SD below this fraction of the incumbent's gets flagged for a human look\nTHREAD_VARS = (\"OMP_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"MKL_NUM_THREADS\", \"VECLIB_MAXIMUM_THREADS\", \"NUMEXPR_NUM_THREADS\")\n\n# ---------------------------------------------------------------- static rules\n\nALLOWED_IMPORTS = {\"odometer\", \"math\"}\nALLOWED_BUILTINS = {\n    \"abs\", \"all\", \"any\", \"bool\", \"dict\", \"divmod\", \"enumerate\", \"float\", \"int\", \"isinstance\", \"len\", \"list\", \"max\",\n    \"min\", \"pow\", \"print\", \"range\", \"reversed\", \"round\", \"set\", \"sorted\", \"str\", \"sum\", \"tuple\", \"zip\",\n    \"True\", \"False\", \"None\",\n}\n# math without its functions over sequences and big integers, which do unbounded numeric work in one counted line\nMATH_NAMES = {n for n in dir(math) if not n.startswith(\"_\")} - {\n    \"comb\", \"dist\", \"factorial\", \"fsum\", \"gcd\", \"hypot\", \"isqrt\", \"lcm\", \"perm\", \"prod\", \"sumprod\",\n}\nCONTAINER_ATTRS = {\n    \"append\", \"extend\", \"insert\", \"pop\", \"remove\", \"reverse\", \"sort\", \"index\", \"count\", \"clear\", \"copy\", \"items\", \"keys\",\n    \"values\", \"get\", \"setdefault\", \"update\", \"join\", \"split\", \"strip\", \"startswith\", \"endswith\",\n}\nBANNED_NODES = (\n    ast.ClassDef, ast.AsyncFunctionDef, ast.AsyncFor, ast.AsyncWith, ast.Await, ast.Try, ast.TryStar, ast.Match,\n    ast.Global, ast.Nonlocal, ast.Delete, ast.TypeAlias,\n)\n\n\ndef allowed_attrs():\n    import odometer as od\n\n    engine = {n for n in dir(od) if not n.startswith(\"_\")} - {\"Tensor\"}\n    tensor = {n for n in dir(od.Tensor) if not n.startswith(\"_\")}\n    return engine, engine | tensor | {\"batch\", \"num_bytes\"} | MATH_NAMES | CONTAINER_ATTRS\n\n\ndef is_constant_expr(node):\n    return all(isinstance(n, (ast.Constant, ast.Tuple, ast.UnaryOp, ast.BinOp, ast.Name, ast.Load, ast.operator, ast.unaryop))\n               for n in ast.walk(node))\n\n\ndef literal_bytes(tree):\n    \"\"\"Everything in the source an entry can read back as data. dict(name=1) and str(function) turn names into strings.\"\"\"\n    docstrings = {id(n.body[0].value) for n in ast.walk(tree)\n                  if isinstance(n, (ast.Module, ast.FunctionDef)) and n.body and isinstance(n.body[0], ast.Expr)\n                  and isinstance(n.body[0].value, ast.Constant) and isinstance(n.body[0].value.value, str)}\n\n    def size(v):\n        if isinstance(v, str):\n            return len(v.encode(\"utf-8\", \"surrogatepass\"))\n        return len(v) if isinstance(v, bytes) else max(8, v.bit_length() // 8) if isinstance(v, int) else 8\n\n    total = 0\n    for n in ast.walk(tree):\n        if isinstance(n, ast.Constant) and id(n) not in docstrings:\n            total += size(n.value)\n        elif isinstance(n, ast.keyword) and n.arg:\n            total += size(n.arg)\n        elif isinstance(n, ast.FunctionDef):\n            total += size(n.name)\n    return total\n\n\ndef static_problems(src, track=TRACK):\n    if len(src.encode()) > track[\"source_cap\"]:\n        return [f\"source is over {track['source_cap']} bytes\"]\n    try:\n        tree = ast.parse(src)\n    except (SyntaxError, MemoryError, RecursionError) as e:\n        return [f\"syntax error: {e}\"]\n    engine, attrs = allowed_attrs()\n    forbidden = set(dir(builtins)) - ALLOWED_BUILTINS\n    nodes = list(ast.walk(tree))\n    clears_grad = {id(t) for n in nodes if isinstance(n, ast.Assign) and isinstance(n.value, ast.Constant) and n.value.value is None\n                   for t in n.targets if isinstance(t, ast.Attribute) and t.attr == \"grad\"}\n    problems = []\n    for node in nodes:\n        line = getattr(node, \"lineno\", 0)\n        if isinstance(node, BANNED_NODES):\n            problems.append(f\"line {line}: {type(node).__name__} is not allowed\")\n        elif isinstance(node, ast.Import):\n            problems += [f\"line {line}: import {a.name}\" for a in node.names if a.name not in ALLOWED_IMPORTS]\n        elif isinstance(node, ast.ImportFrom):\n            if node.level or node.module not in ALLOWED_IMPORTS:\n                problems.append(f\"line {line}: from {'.' * node.level}{node.module or ''} import\")\n            else:\n                names = engine if node.module == \"odometer\" else MATH_NAMES\n                problems += [f\"line {line}: from {node.module} import {a.name}\" for a in node.names if a.name not in names]\n        elif isinstance(node, ast.alias):\n            if node.asname and node.asname.startswith(\"_\"):  # import math as __builtins__ swaps the builtins table\n                problems.append(f\"line {line}: {node.asname} starts with an underscore\")\n        elif isinstance(node, ast.Attribute):\n            if node.attr not in attrs:\n                problems.append(f\"line {line}: .{node.attr} is not on the allowed list\")\n            if not isinstance(node.ctx, ast.Load) and id(node) not in clears_grad:\n                problems.append(f\"line {line}: assigning to .{node.attr}\")\n        elif isinstance(node, ast.Name):\n            if node.id.startswith(\"_\") and node.id != \"_\":\n                problems.append(f\"line {line}: {node.id} starts with an underscore\")\n            elif node.id in forbidden:\n                problems.append(f\"line {line}: builtin {node.id} is not on the allowed list\")\n        elif isinstance(node, (ast.FunctionDef, ast.Lambda)):\n            if isinstance(node, ast.FunctionDef):\n                if node.name.startswith(\"_\"):\n                    problems.append(f\"line {line}: {node.name} starts with an underscore\")\n                if node.decorator_list:  # a decorator is a call at module level, so it could build state that persists\n                    problems.append(f\"line {line}: decorators are not allowed\")\n                if node.returns and not is_constant_expr(node.returns):\n                    problems.append(f\"line {line}: an annotation must be a constant\")\n            if not all(is_constant_expr(d) for d in [*node.args.defaults, *node.args.kw_defaults] if d is not None):\n                problems.append(f\"line {line}: a default argument must be a constant\")\n        elif isinstance(node, ast.arg) and node.annotation and not is_constant_expr(node.annotation):\n            problems.append(f\"line {line}: an annotation must be a constant\")  # annotations run once, at def time\n    for node in tree.body:\n        fine = isinstance(node, (ast.Import, ast.ImportFrom, ast.FunctionDef))\n        fine |= isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n        fine |= (isinstance(node, ast.Assign) and all(isinstance(t, ast.Name) for t in node.targets) and is_constant_expr(node.value))\n        if not fine:\n            problems.append(f\"line {node.lineno}: module level allows only imports, defs and constants\")\n    if literal_bytes(tree) > track[\"literal_cap\"]:\n        problems.append(f\"literals total {literal_bytes(tree)} bytes, over the cap of {track['literal_cap']}\")\n    if len(nodes) > track[\"node_cap\"]:\n        problems.append(f\"source has {len(nodes)} syntax nodes, over the cap of {track['node_cap']}\")\n    top = {n.name for n in tree.body if isinstance(n, ast.FunctionDef)}\n    problems += [f\"no top-level {f}()\" for f in (\"train\", \"forward\") if f not in top]\n    return problems\n\n\ndef load_entry(path, track):\n    \"\"\"Execute the entry with a builtins table that has no way out of the engine.\"\"\"\n    src = pathlib.Path(path).read_text(encoding=\"utf-8\")\n    problems = static_problems(src, track)\n    if problems:\n        raise SystemExit(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n\n    def guarded_import(name, globals=None, locals=None, fromlist=(), level=0):\n        if level or name not in ALLOWED_IMPORTS:\n            raise ImportError(f\"import of {name} is not allowed\")\n        return builtins.__import__(name, globals, locals, fromlist, level)\n\n    safe = {k: getattr(builtins, k) for k in ALLOWED_BUILTINS}\n    safe[\"__import__\"] = guarded_import\n    module = types.ModuleType(\"entry\")\n    module.__dict__[\"__builtins__\"] = safe\n    exec(compile(src, str(path), \"exec\"), module.__dict__)\n    return module\n\n\ndef peak_rss_mb():\n    try:\n        import resource\n    except ImportError:  # Windows\n        return None\n    kb = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n    return kb / 1024 ** (2 if sys.platform == \"darwin\" else 1)\n\n\ndef count_python_work(entry, cap, violation):\n    \"\"\"Deterministic fence on Python outside the engine: every line and jump of the entry costs one count.\"\"\"\n    mon, events = sys.monitoring, sys.monitoring.events\n    seen = [0]\n\n    def on_event(code, *rest):\n        if code.co_filename != entry:\n            return mon.DISABLE\n        seen[0] += 1\n        if seen[0] > cap:\n            raise violation(f\"more than {cap} Python lines and jumps in the entry\")\n\n    mon.use_tool_id(mon.PROFILER_ID, \"odometer\")\n    mon.register_callback(mon.PROFILER_ID, events.LINE, on_event)\n    mon.register_callback(mon.PROFILER_ID, events.JUMP, on_event)\n    mon.set_events(mon.PROFILER_ID, events.LINE | events.JUMP)\n    return seen\n\n\n# ---------------------------------------------------------------- the two child processes\n\n\ndef child_train(entry, seed, out):\n    import numpy as np\n\n    import odometer as od\n    from odometer import _data, _engine\n\n    out = pathlib.Path(out)\n    track = json.loads((out / \"track.json\").read_text())\n    _engine._M.reset(track[\"train_budget\"], seed, item_cap=track[\"item_cap\"])\n    data = _data.TrainData()\n    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n    t0 = time.perf_counter()\n    status, params = \"ok\", None\n    try:\n        params = load_entry(entry, track).train(data)\n    except od.BudgetExhausted as e:\n        status = f\"void: BudgetExhausted escaped train() ({e})\"\n    except od.RuleViolation as e:\n        status = f\"void: rule violation: {e}\"\n    seconds = time.perf_counter() - t0\n    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n    if status == \"ok\":\n        if not isinstance(params, dict) or not all(isinstance(k, str) and type(v) is od.Tensor for k, v in params.items()):\n            status = \"void: train() must return a dict of name -> Tensor\"\n        elif any(v.is_int for v in params.values()):\n            status = \"void: parameters must be float tensors\"\n        elif sum(v.size + len(k) for k, v in params.items()) > track[\"param_cap\"]:\n            status = f\"void: more than {track['param_cap']} parameters, with one more per character of their names\"\n        else:\n            np.savez(out / \"params.npz\", **{f\"p{i}\": v._d for i, v in enumerate(params.values())})\n            (out / \"names.json\").write_text(json.dumps(list(params)))\n    report = {\"status\": status, \"train_ticks\": _engine._M.used, \"train_seconds\": seconds, \"item_reads\": _engine._M.items,\n              \"train_python_lines\": lines[0], \"peak_rss_mb\": peak_rss_mb(), \"params\": sum(v.size for v in params.values()) if status == \"ok\" else None}\n    (out / \"train.json\").write_text(json.dumps(report))\n\n\ndef child_eval(entry, seed, split, out):\n    import numpy as np\n\n    import odometer as od\n    from odometer import _data, _engine\n\n    out = pathlib.Path(out)\n    track = json.loads((out / \"track.json\").read_text())\n    C, B = track[\"eval_context\"], track[\"eval_batch\"]\n    windows = _data.heldout_windows(split, C, track[\"eval_windows\"])\n    n = len(windows)\n    rng = np.random.default_rng([seed, 2])\n    twins = np.sort(rng.choice(n, int(n * track[\"twin_fraction\"]), replace=False))\n    cuts = rng.integers(1, C, size=twins.size)\n    donors = windows[rng.integers(0, n, size=twins.size)]\n    rows = np.concatenate([windows[:, :C], windows[twins, :C]])\n    probe = []\n    for j, (cut, donor) in enumerate(zip(cuts, donors)):\n        rows[n + j, cut:] = donor[cut:C]\n        last = np.arange(max(0, cut - 8), cut)  # a look-ahead leak shows first just before the cut\n        probe.append(np.union1d(last, rng.choice(cut, min(cut, track[\"twin_positions\"]), replace=False)))\n    probe_rows = {int(r): j for j, r in enumerate(twins)} | {n + j: j for j in range(twins.size)}\n    order = rng.permutation(len(rows))\n\n    scored_bytes = len(rows) * C\n    _engine._M.reset(track[\"eval_ticks_per_byte\"] * scored_bytes, seed, mode=\"eval\")\n    lines = count_python_work(entry, track[\"python_lines\"], od.RuleViolation)\n    t0 = time.perf_counter()\n    status = \"ok\"\n    nll = np.zeros(n)\n    seen = {}\n    try:\n        module = load_entry(entry, track)\n        names = json.loads((out / \"names.json\").read_text())\n        stored = np.load(out / \"params.npz\")\n        arrays = {name: stored[f\"p{i}\"] for i, name in enumerate(names)}\n        for a in arrays.values():\n            a.setflags(write=False)\n        for start in range(0, len(rows), B):\n            idx = order[start : start + B]\n            logits = module.forward({k: od.Tensor(a) for k, a in arrays.items()}, od.Tensor(rows[idx].astype(np.int32)))\n            if type(logits) is not od.Tensor or logits.is_int or logits.shape != (len(idx), C, od.VOCAB):\n                raise od.RuleViolation(f\"forward() must return float logits of shape (batch, {C}, {od.VOCAB})\")\n            z = logits._d.astype(np.float64)\n            if not np.isfinite(z).all():\n                raise od.RuleViolation(\"forward() returned non-finite logits\")\n            lp = z - z.max(-1, keepdims=True)\n            lp -= np.log(np.exp(lp).sum(-1, keepdims=True))\n            for b, r in enumerate(idx):\n                if r < n:\n                    nll[r] = -lp[b, np.arange(C), windows[r, 1:]].sum()\n                if int(r) in probe_rows:\n                    j = probe_rows[int(r)]\n                    seen.setdefault(j, []).append(lp[b, probe[j]])\n    except od.BudgetExhausted:\n        status = f\"void: forward() cost more than {track['eval_ticks_per_byte']:,} ticks per byte\"\n    except od.RuleViolation as e:\n        status = f\"void: rule violation: {e}\"\n    sys.monitoring.set_events(sys.monitoring.PROFILER_ID, 0)\n    twin_diff = max((float(np.abs(a - b).max()) for a, b in seen.values()), default=0.0) if status == \"ok\" else None\n    if status == \"ok\" and twin_diff > track[\"twin_tolerance\"]:\n        status = f\"void: twin check failed (logits before the cut moved by {twin_diff:.2e} nats)\"\n    report = {\"status\": status, \"split\": split, \"bpb\": float(nll.sum() / (n * C) / np.log(2)) if status == \"ok\" else None,\n              \"eval_ticks_per_byte\": _engine._M.used / scored_bytes, \"twin_max_diff\": twin_diff,\n              \"eval_python_lines\": lines[0], \"eval_seconds\": time.perf_counter() - t0}\n    (out / \"eval.json\").write_text(json.dumps(report))\n\n\n# ---------------------------------------------------------------- the parent\n\n\ndef run_seed(entry, seed, split, track, keep):\n    env = {\"PATH\": os.environ.get(\"PATH\", \"\"), **{v: \"1\" for v in THREAD_VARS}}\n    with tempfile.TemporaryDirectory() as tmp:\n        (pathlib.Path(tmp) / \"track.json\").write_text(json.dumps(track))\n        result = {\"seed\": seed}\n        for stage, extra in ((\"train\", []), (\"eval\", [split])):\n            cmd = [sys.executable, \"-I\", str(ROOT / \"verify.py\"), f\"--child-{stage}\", str(entry), str(seed), *extra, tmp]\n            log = keep / f\"seed-{seed}-{stage}.log\"\n            try:\n                with open(log, \"wb\") as sink:\n                    subprocess.run(cmd, cwd=tmp, env=env, stdout=sink, stderr=subprocess.STDOUT, timeout=track[\"wall_limit_seconds\"])\n            except subprocess.TimeoutExpired:\n                result[\"status\"] = f\"void: {stage} process passed the wall limit\"\n                return result\n            path = pathlib.Path(tmp) / f\"{stage}.json\"\n            if not path.exists():\n                result[\"status\"] = f\"void: {stage} process crashed (see {log.name})\"\n                return result\n            result |= json.loads(path.read_text())\n            if result[\"status\"] != \"ok\":\n                return result\n        return result\n\n\ndef machine():\n    import numpy as np\n\n    blas = np.show_config(mode=\"dicts\")[\"Build Dependencies\"][\"blas\"]\n    return {\"platform\": platform.platform(), \"machine\": platform.machine(), \"python\": platform.python_version(),\n            \"numpy\": np.__version__, \"blas\": f\"{blas.get('name')} {blas.get('version')}\", \"cpus\": os.cpu_count()}\n\n\ndef code_hash():\n    h = hashlib.sha256()\n    for p in [ROOT / \"verify.py\", *sorted((ROOT / \"odometer\").glob(\"*.py\"))]:\n        h.update(p.read_bytes())\n    return h.hexdigest()\n\n\ndef run_batch(entry, seeds, split, track, logs, jobs, label=\"\"):\n    with ThreadPoolExecutor(jobs) as pool:\n        results = []\n        for r in pool.map(lambda s: run_seed(entry, s, split, track, logs), seeds):\n            results.append(r)\n            if r[\"status\"] == \"ok\":\n                print(f\"  seed {r['seed']:>10}  {split} bpb {r['bpb']:.4f}  train {r['train_ticks']:.3e} ticks  \"\n                      f\"{r['train_seconds']:6.1f} s  eval {r['eval_ticks_per_byte']:,.0f} ticks/byte  \"\n                      f\"twins {r['twin_max_diff']:.1e}{label}\", flush=True)\n            else:\n                print(f\"  seed {r['seed']:>10}  {r['status']}{label}\", flush=True)\n    return results\n\n\ndef fresh_seeds(n):\n    return [secrets.randbits(31) for _ in range(n)]\n\n\ndef judge(bpbs, record_bpbs):\n    \"\"\"Does this batch beat the record by more than the margin? Welch, one-sided, on the verifier's own seeds.\"\"\"\n    w = stats.welch(bpbs, [b - RECORD_MARGIN for b in record_bpbs])\n    plain = stats.welch(bpbs, record_bpbs)\n    return {\"gain\": -plain[\"diff\"], \"ci95\": plain[\"ci95\"], \"df\": w[\"df\"], \"p_beyond_margin\": w[\"p_one_sided\"],\n            \"passes\": w[\"p_one_sided\"] < RECORD_ALPHA}\n\n\ndef main():\n    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\n    ap.add_argument(\"entry\")\n    ap.add_argument(\"--seeds\", default=\"8\", help=\"a count of fresh seeds, or a comma list to rerun exact seeds ('11,' is seed 11)\")\n    ap.add_argument(\"--split\", default=\"test\", choices=(\"dev\", \"test\"))\n    ap.add_argument(\"--jobs\", type=int, default=0, help=\"seeds in parallel (default: min(seeds, cpus))\")\n    ap.add_argument(\"--against\", help=\"a record log; tests whether this entry beats it, then confirms on new seeds\")\n    ap.add_argument(\"--smoke\", action=\"store_true\", help=\"a tiny budget and a few windows; the number is not a score\")\n    ap.add_argument(\"--out\", help=\"where to write the log (default runs/<entry>-<time>.json)\")\n    args = ap.parse_args()\n\n    track = {**TRACK, **SMOKE} if args.smoke else TRACK\n    entry = pathlib.Path(args.entry).resolve()\n    src = entry.read_text(encoding=\"utf-8\")\n    problems = static_problems(src, track)\n    if problems:\n        print(\"static rules failed:\\n  \" + \"\\n  \".join(problems))\n        sys.exit(2)\n    seeds = [int(s) for s in args.seeds.split(\",\") if s] if \",\" in args.seeds else fresh_seeds(int(args.seeds))\n    name = entry.parent.name if entry.name == \"train.py\" else entry.stem\n    stamp = time.strftime(\"%Y%m%d-%H%M%S\")\n    out = pathlib.Path(args.out) if args.out else ROOT / \"runs\" / f\"{name}-{stamp}.json\"\n    logs = out.with_suffix(\"\")\n    logs.mkdir(parents=True, exist_ok=True)\n    jobs = args.jobs or max(1, min(len(seeds), os.cpu_count() or 1))\n    print(f\"{name}: {len(seeds)} seeds on {args.split}, {jobs} at a time, budget {track['train_budget']:.1e} ticks\"\n          + (\" (smoke run: not a score)\" if args.smoke else \"\"), flush=True)\n\n    t0 = time.time()\n    results = run_batch(entry, seeds, args.split, track, logs, jobs)\n    ok = [r[\"bpb\"] for r in results if r[\"status\"] == \"ok\"]\n    log = {\"entry\": str(entry.relative_to(ROOT)) if entry.is_relative_to(ROOT) else entry.name,\n           \"sha256\": hashlib.sha256(src.encode()).hexdigest(), \"code_sha256\": code_hash(), \"track\": track,\n           \"split\": args.split, \"smoke\": args.smoke, \"machine\": machine(), \"started\": stamp, \"seeds\": results}\n    if len(ok) == len(results) and len(ok) >= 2:\n        m, half = stats.ci95(ok)\n        log[\"summary\"] = {\"mean_bpb\": m, \"ci95\": half, \"sd\": stats.mean_sd(ok)[1], \"n\": len(ok)}\n        print(f\"  mean {m:.4f} +- {half:.4f} bpb (95% CI, n={len(ok)}, sd {log['summary']['sd']:.4f})\")\n    elif len(ok) != len(results):\n        print(\"  void: at least one seed failed, so the entry has no score\")\n    elif ok:\n        print(f\"  {ok[0]:.4f} bpb on one seed (use at least 2 for an interval)\")\n\n    if args.against and \"summary\" in log:\n        inc = json.loads(pathlib.Path(args.against).read_text())\n        if inc[\"split\"] != args.split:\n            raise SystemExit(\"the record was scored on a different split\")\n        incumbent = [r[\"bpb\"] for r in inc.get(\"confirmation\", inc[\"seeds\"])]\n        stage1 = judge(ok, incumbent)\n        verdict = {\"against\": args.against, \"margin\": RECORD_MARGIN, \"alpha\": RECORD_ALPHA, \"stage1\": stage1, \"record\": False}\n        print(f\"  gain over the record: {stage1['gain']:+.4f} +- {stage1['ci95']:.4f} bpb, p = {stage1['p_beyond_margin']:.2g} \"\n              f\"(beyond a margin of {RECORD_MARGIN})\")\n        if stats.mean_sd(ok)[1] < LOW_VARIANCE_RATIO * stats.mean_sd(incumbent)[1]:\n            verdict[\"flag\"] = \"seed SD is far below the incumbent's; read the entry for a fixed init or data order\"\n            print(f\"  flag: {verdict['flag']}\")\n        if stage1[\"passes\"]:\n            print(\"  passed; confirming on new seeds\", flush=True)\n            second = run_batch(entry, fresh_seeds(len(seeds)), args.split, track, logs, jobs, label=\"  (confirmation)\")\n            log[\"confirmation\"] = second\n            good = [r[\"bpb\"] for r in second if r[\"status\"] == \"ok\"]\n            if len(good) == len(second):\n                stage2 = judge(good, incumbent)\n                verdict[\"stage2\"] = stage2\n                verdict[\"record\"] = stage2[\"passes\"]\n                print(f\"  confirmation: {stage2['gain']:+.4f} +- {stage2['ci95']:.4f} bpb, p = {stage2['p_beyond_margin']:.2g}\")\n        print(\"  NEW RECORD\" if verdict[\"record\"] else \"  not a record\")\n        log[\"verdict\"] = verdict\n    log[\"wall_seconds\"] = time.time() - t0\n    out.parent.mkdir(parents=True, exist_ok=True)\n    out.write_text(json.dumps(log, indent=1))\n    print(f\"  log: {out.relative_to(ROOT) if out.is_relative_to(ROOT) else out}\")\n    if len(ok) != len(results):\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    if len(sys.argv) > 1 and sys.argv[1] == \"--child-train\":\n        child_train(sys.argv[2], int(sys.argv[3]), sys.argv[4])\n    elif len(sys.argv) > 1 and sys.argv[1] == \"--child-eval\":\n        child_eval(sys.argv[2], int(sys.argv[3]), sys.argv[4], sys.argv[5])\n    else:\n        main()\n", "numLines": 499, "startLine": 1, "totalLines": 499}}, "tool_result_meta": [{"id": "toolu_01Meen2iquTv6ceP3fn5q1oU", "permission_decision": {"decision": "accept", "source": "config", "reason_type": "rule"}}]}
